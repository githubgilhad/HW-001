MSG "## Test write and read REG7 & REG8";
ORDER: !Dev_FIRQ, %1, !Reset, !A_HALT, !B_HALT, !HALT, BA, %1, E, Q, Rw, %1, A_READ, B_READ , %1, CA, %1, DATA, %1, COUNT, %1, TIMER_EN,addr_in_REGS, in_HALT_mode;


VECTORS:
* 011*0 010 11 'A008' '80' "*" ***

$MSG "## write reg 8 ";
