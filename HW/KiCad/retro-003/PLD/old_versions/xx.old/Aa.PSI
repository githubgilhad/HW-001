MSG "### PSI macros, use SI_preprocessor.py Aa.psi Aa.si ###";
#def_macro READ_REG(reg_num)
$MSG "### READ_REG({reg_num}) ###";
$set CA   = '{'A000'+reg_num}';
$set DATA = "X";
$set E    = 0;
$set Q    = 1;
$set Rw   = 1;
$OUT;
$set E    = 1;
$OUT;
$set Q    = 0;
$OUT;
$set E    = 0;
$OUT;

#end_macro

#def_macro WRITE_REG(reg_num, value)
$MSG "### WRITE_REG({reg_num}, {value}) ###";
$set CA   = '{'A000'+reg_num}';
$set DATA = '{value}';
$set E    = 0;
$set Q    = 1;
$set Rw   = 0;
$OUT;
$set E    = 1;
$OUT;
$set Q    = 0;
$OUT;
$set E    = 0;
$OUT;

#end_macro

MSG "## Test for HALT only";

ORDER: !A_HALT, !B_HALT, !HALT; 


VECTORS:
11Z /* pullup get it high */
01L
00L
00L
00L
10L
10L
10L
11Z /* pullup get it high from now */
11Z
11Z
11Z

MSG "## test HALT and Rw in HALT mode";
ORDER: !A_HALT, !B_HALT, !HALT, BA, E, Rw, %1, A_READ, B_READ , %1, CA, %1, DATA; 


VECTORS:
$MSG "## NOT HALT";
11*010 00 'A000' '5A' 
$MSG "## HALT";
01*10* 00 'A000' '5A'
00*11* 00 'A000' '5A'
00*10* 00 'A000' '5A'
00*11* 00 'A000' '5A'
10*10* 00 'A000' '5A'
10*11* 00 'A000' '5A'
10*10* 00 'A000' '5A'
$MSG "## NOT HALT";
11*010 00 'A000' '5A'
11*000 00 'A000' '5A'
11*010 00 'A000' '5A'

