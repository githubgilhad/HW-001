MSG "## Test write and read REG7 & REG8";
ORDER: !Dev_FIRQ, %1, !Reset, !A_HALT, !B_HALT, !HALT, BA, %1, E, Q, Rw, %1, A_READ, B_READ , %1, CA, %1, DATA, %1, COUNT, %1, TIMER_EN,addr_in_REGS, in_HALT_mode;


VECTORS:
* 011*0 010 11 'A008' '80' "*" ***

$MSG "## write reg 8 ";
* 111*0 010 11 'A008' '80' "*" *** 
* 111*0 110 11 'A008' '80' "*" ***
* 111*0 100 11 'A008' '80' "*" ***
* 111*0 000 11 'A008' '80' "*" ***

$MSG "## read reg 7 ";
* 111*0 011 11 'A007' "*" "*" ***
* 111*0 111 11 'A007' "*" "*" ***
* 111*0 101 11 'A007' "*" "*" ***
* 111*0 001 11 'A007' "*" "*" ***

$MSG "## read reg 8 ";
* 111*0 011 11 'A008' "*" "*" *** 
* 111*0 111 11 'A008' "*" "*" ***
* 111*0 101 11 'A008' "*" "*" ***
* 111*0 001 11 'A008' "*" "*" ***

MSG "## Test FIRQ (with [CNT11..6].AP = Reset; /* .AR */ ";
ORDER: !Dev_FIRQ, %1, !Reset, BA, %1, E, Q, Rw, %1, CA, %1, DATA, %1, " CNT:", COUNT, %1, TIMER_EN, " CNT_R:", CNT_R11, CNT_R10, CNT_R9, CNT_R8 ;


VECTORS:

$MSG "## Reset all";
Z 00 C01 'A008' "*" "*" *****

$MSG "## write TIMER_EN true";
Z 10 110 'A008' '80' "*" *****
Z 10 100 'A008' '80' "*" *****

$MSG "## read TIMER_EN by hands";
Z 10 001 'A008' "*" "*" *****
Z 10 011 'A008' "*" "*" *****
Z 10 111 'A008' "*" "*" *****
Z 10 101 'A008' "*" "*" *****
