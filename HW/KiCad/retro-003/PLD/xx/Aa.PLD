	Pin  32 = IO_26;
	Pin  33 = IO_27;
	Pin  35 = IO_28;
	Pin  36 = IO_29;
	Pin  37 = IO_30;
	Pin  40 = IO_31;
	Pin  41 = IO_32;
	Pin  42 = IO_33;
	Pin  44 = IO_34;
	Pin  45 = IO_35;
	Pin  46 = IO_36;
	Pin  47 = IO_37;
	Pin  48 = IO_38;
	Pin  49 = IO_39;
	Pin  50 = IO_40;
	Pin  52 = IO_41;
	Pin  53 = IO_42;
	Pin  54 = IO_43;
	Pin  55 = IO_44;
	Pin  56 = IO_45;
	Pin  57 = IO_46;
	Pin  58 = IO_47;
	Pin  60 = IO_48;
	Pin  61 = IO_49;
	Pin  63 = IO_50;
	Pin  64 = IO_51;
	Pin  65 = IO_52;
	Pin  67 = IO_53;
