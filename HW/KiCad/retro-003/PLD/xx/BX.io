CHIP "Z:\BX"
BEGIN

    DEVICE = "TQFP100";
    "D2"                                      : INPUT_PIN = 97 ;
    "D1"                                      : INPUT_PIN = 96 ;
    "D0"                                      : INPUT_PIN = 94 ;
    "TDI"                                     : INPUT_PIN = 4 ;
    "TMS"                                     : INPUT_PIN = 15 ;
    "rom_sz0"                                 : NODE_NUM = 680 ;
    "rom_sz1"                                 : NODE_NUM = 681 ;
    "rom_sz2"                                 : NODE_NUM = 682 ;
    "TCK"                                     : INPUT_PIN = 62 ;
    "TDO"                                     : INPUT_PIN = 73 ;
    "Q"                                       : INPUT_PIN = 90 ;
END;
