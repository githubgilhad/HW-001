	
	/************************************************************/
	
	NODE Nothing;
	Nothing = Dev_Sel_1 & Dev_Sel_2;
	
	NODE   MR3;
	NODE   MR2;
	NODE   MR1;
	NODE   MR0;
	
	
	
	
	/************************************************************/
	/* ADDRESS DECODE                                           */
	/************************************************************/
	
	NATIVE_RAM_LO = CA:[0000..7FFF];
	
	EMS1_WINDOW = CA:[8000..8FFF];
	
	EMS2_WINDOW = CA:[9000..9FFF];
	
	
	REG_RESERVED = CA:[A007..A01F]; 
	
	
/*	NATIVE_RAM_HI = ROM_24K & !ROM_AREA; */
	
	
	
	
	
	/************************************************************/
	/* MEMORY REGION BUS                                        */
	/************************************************************/
	
	MR0 = !BA & (
		  EMS1_WINDOW
		# ROM_AREA
		# REG1
		# REG3
		# REG5
		# REG_RESERVED
		);
	
	MR1 = !BA & (
		  EMS2_WINDOW
		# ROM_AREA
		# REG2
		# REG3
		# REG6
		# REG_RESERVED
		);
	
	MR2 = !BA & (
		  DEVICE_AREA
		# REG4
		# REG5
		# REG6
		# REG_RESERVED
		);
	
	MR3 = !BA & (
		  REG0
		# REG1
		# REG2
		# REG3
		# REG4
		# REG5
		# REG_RESERVED
		);
	
	/*
		HALT/BA active	MR = 0; 	0000  // pri HALTu je vsechno RAM
	
		NATIVE_RAM_LO	MR = 0; 	0000
		NATIVE_RAM_HI	MR = 0; 	0000
		EMS1_WINDOW	MR = 1; 	0001
		EMS2_WINDOW	MR = 2; 	0010
		
		REG0		MR = 8; 	1000
		REG1		MR = 9; 	1001
		REG2		MR = A; 	1010
		REG3		MR = B; 	1011
		REG4		MR = C; 	1100
		REG5		MR = D; 	1101
		REG6		MR = E; 	1110
		
		REG_RESERVED	MR = 15; 	1111
		
		DEVICE_AREA	MR = 4; 	0100
		
		ROM_AREA	MR = 3; 	0011
	*/
	
	/************************************************************/
	/* SOME DECLARATION - need to check {{{                     */
	/************************************************************/
	
	
	TRUE = E # !E;
	FALSE = E & !E;
	
	/************************************************************/
	/* FIELDS                                                   */
	/************************************************************/
	
	FIELD MR = [MR3..MR0];
	
	
	/************************************************************/
	/* INTERNAL NODES                                           */
	/************************************************************/
	
	
	
	
	
	/************************************************************/
	/* Derived signals                                          */
	/************************************************************/
	
	NODE EMS1_is_SYS;
	NODE EMS1_is_MHFA;
	NODE EMS1_is_MHFB;
	NODE EMS1_is_ROM;
	
	NODE EMS2_is_SYS;
	NODE EMS2_is_MHFA;
	NODE EMS2_is_MHFB;
	NODE EMS2_is_ROM;
	
	
	NODE CHIPA_W;
	NODE CHIPB_W;
	
	NODE HALT_MODE;
	
	NODE REG_ACCESS;
	NODE REG_READ;
	NODE REG_WRITE;
	
	NODE EMS_WINDOW;
	NODE ROM_WINDOW;
	NODE RAM_WINDOW;
	
	NODE ACTIVE_PAGE_A1;
	NODE ACTIVE_PAGE_A0;
	
	NODE ACTIVE_B4;
	NODE ACTIVE_B3;
	NODE ACTIVE_B2;
	NODE ACTIVE_B1;
	NODE ACTIVE_B0;
	
	NODE ACTIVE_SYS;
	NODE ACTIVE_MHFA;
	NODE ACTIVE_MHFB;
	/* NODE ACTIVE_ROM;*/
	
	NODE CPU_REQ_A;
	NODE CPU_REQ_B;
	NODE MHF_REQ_A;
	NODE MHF_REQ_B;
	
	NODE EMS1_C;
	NODE EMS2_C;
	NODE EMS1_W;
	NODE EMS2_W;
	
	/* }}} */
	/************************************************************/
	/* CONSTANT DECODE - need to check {{{                      */
	/************************************************************/
	
	RAM_WINDOW =
	       (MR:0);
	
	EMS_WINDOW =
	       (MR:1)
	    #  (MR:2);
	
	ROM_WINDOW =
	       (MR:3);
	
