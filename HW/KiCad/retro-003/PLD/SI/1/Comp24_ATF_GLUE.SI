$MSG "## zapis do lokalni SharedRAM primo: vybrana je podle B_SHARE_REQUEST, B_READ nastavuje B_S_READ a B_S_WRITE";
$MSG "## B_SHARE_REQUEST=0 vypnu B_S_SELECT";
"Z" "Z" 00 *HH 1* *"Z" 11 10*1 *ZZZZZ H* "H" HH HH 11 00 01 HH HH ** ** HH **   "*" 1* ** ** ***** ** ***** **** ****  * "*" "*" 
$MSG "## ATmega2560 si nastavi si SharedAddressA0..15 a B_S_16 podle potreby, pak si zapne data";
$MSG "## pak nastavi B_READ=0 , zatin se nic nedeje, neni B_S_SELECT";
"Z" "Z" 00 *HH 1* *"Z" 11 10*1 *ZZZZZ H* "H" HH HH 10 00 01 HH HH ** ** HH **   "*" 1* ** ** ***** ** ***** **** ****  * "*" "*" 
$MSG "## ted nastavi B_SHARE_REQUEST=1 => B_S_SELECT se aktivuje a tim zapise spravnou hodnotu";
