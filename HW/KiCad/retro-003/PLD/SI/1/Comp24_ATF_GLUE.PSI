#set GA16 = L
#call blind_write(B,56) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ########################################
#msg ### clear SharedRAM
#msg ########################################
#msg Cil: B_S_16=Z, gates closed, Shared=active, B_S_READ/B_S_WRITE podle B_READ, B_S_SELECT active, MHF si muze psat co chce
#msg B_SHARE_SELECT=1 (manage SharedRAM) => RAM_Sel NOT active, B_G_ENABLE NOT active, SharedRAM active
#msg B_S_16 je ovladan ATmega2560 a pouzivan pro pristup k lokalni SharedRAM primo, jedine co muzeme udelat je ho ignorovat == drzet RAM_Sel not active, dokud se neuplatni B_S_16, nebo neskonci in_HALT_mode
#set B_SHARE_SELECT=1
#set B_S_16=1 // ~ nahodne se menici hodnota
#set GA16=*
#set Rw=*
#set B_G_D_DIR=* // ~ nevim, co tu bude, ale protoze se RAM_Sel neaktivuje (ani nic jineho), tak je to jedno - MHFB si pise pro sebe
#set RAM_Sel=H
#set B_G_ENABLE=H
#set B_S_SELECT=L
#set B_READ=1
#set DATA="Z"
#set CADDR="Z"
#set GADDR="Z"
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#call clock(L,H) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg zapis do lokalni SharedRAM primo: vybrana je podle B_SHARE_REQUEST, B_READ nastavuje B_S_READ a B_S_WRITE
#msg B_SHARE_REQUEST=0 vypnu B_S_SELECT
#set B_SHARE_REQUEST=0
#set B_S_SELECT=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ATmega2560 si nastavi si SharedAddressA0..15 a B_S_16 podle potreby, pak si zapne data
#msg pak nastavi B_READ=0 , zatin se nic nedeje, neni B_S_SELECT
#set B_READ=0
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ted nastavi B_SHARE_REQUEST=1 => B_S_SELECT se aktivuje a tim zapise spravnou hodnotu
#set B_SHARE_REQUEST=1
#set B_S_SELECT=L
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg pocka jeden takt, shodi B_SHARE_REQUEST a dal muze menit B_READ, data a adresy po libosti 
#msg B_SHARE_REQUEST=0 vypnu B_S_SELECT
#set B_SHARE_REQUEST=0
#set B_S_SELECT=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ATmega2560 si da data HiZ a muze nastavit dalsi adresu a opakovat
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg uklidime si vystupy:
#set B_SHARE_REQUEST=0
#set B_READ=1
#set B_SHARE_SELECT=0
