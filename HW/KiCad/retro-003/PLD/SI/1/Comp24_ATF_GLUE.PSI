ORDER: 
	DATA, 
	%1, CADDR, 
	%1, E, Q, 
	%1, "Rw:", Rw, !Read, !Write,
	%1, "R:", !Reset, in_HALT_mode, 
	%1, "G:", GA16, GADDR,
	%1, A_S_16, B_S_16,
	%1, "H:", !A_HALT, !B_HALT, !HALT, BA,
	%1, "C:", !Dev_FIRQ, !Dev_IRQ, !Dev_NMI, !DMA_BREQ, BS, MRDY, 
	%1, "OE:", !RAM_Sel, !ROM_Sel,
	%1, !Dev_Sel_lines, 
	%1, "Sg:", !A_S_SELECT, !B_S_SELECT, %1, !A_G_ENABLE, !B_G_ENABLE,
	%1, "In:", /* inputs */ A_READ, B_READ, %1, A_SHARE_REQUEST, B_SHARE_REQUEST, %1, A_SHARE_SELECT, B_SHARE_SELECT, 
	%1, "Out:", /* outputs */ A_SHARE_COOP, B_SHARE_COOP, %1, A_SHARE_GRANTED, B_SHARE_GRANTED, %1, !A_S_READ, !B_S_READ, %1, !A_S_WRITE, !B_S_WRITE, %1, A_G_A_DIR, B_G_A_DIR, %1, A_G_D_DIR, B_G_D_DIR, 
	%3, "Rs:",/* nodes */ ROM_SIZE,
	%1, BootSrc, RomMapped, 
	%1, addr_in_REGS, addr_in_DEVS, 
	%1, "E1:", /* EMS1 mapping */ EMS1_A1, EMS1_A0, %1, EMS1_B4, EMS1_B3, EMS1_B2, EMS1_B1, EMS1_B0,
	%1, "E2:", /* EMS2 mapping */ EMS2_A1, EMS2_A0, %1, EMS2_B4, EMS2_B3, EMS2_B2, EMS2_B1, EMS2_B0,
	%1, "Ow:",/* ownership */ CHIPA_A, CHIPA_C, CHIPB_A, CHIPB_C, %1, CHIPA_Dc, CHIPA_Dm, CHIPB_Dc, CHIPB_Dm, 
	%2, "T:",TIMER_EN, %1, COUNT, %1, COUNT_R,
	%1;

