#call Defaults() //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Reset ma kondenzator a 'vyssi prah citlivosti', zacina na nule,  spina jako posledni
#set Reset=0 // HW set
#msg A_HALT je pulldown dolu => HALT je aktivni => BA je aktivni, nez reset skonci
#set A_HALT = 0 // HW set
#set BA=1 // CPU set
#msg BA aktivni => nastane in_HALT_mode => A_SHARE_COOP je aktivni (protoze mam A_HALT) a B_SHARE_COOP je NEaktivni (protoze mam A_HALT)
#msg NOTE: jeste je na to moc brzo (Reset teprve zacina), ale jakmile MHF nabootuje a ma X_SHARE_COOP aktivni, tak je nejspis MHFA, nebo oproti nemu bootovalo velmi pomalu
#msg Rw je Read, protoze A_READ je pullup
#set Rw = H
#msg CADDR je HiZ, protoze je HALT
#set CADDR = 'Z'
#gen_vector //  ---------------------------------------------------------------------------------------------------------------------------------------------------------------- 
#msg B_HALT ma taky pulldown (ale otestujeme spravnou polaritu)
#set B_HALT = 0 // HW set
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Reset konecne konci, nastava regulatni in_HALT_mode
#set Reset=1 // HW set
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Initial HALT
#comm_start
	(Reset ma kondenzator a "vyssi prah citlivosti", spina jako posledni)
	* nabehne napajeci napeti
	* `A_HALT` je pulldownem drzeny dole
		* GLUE logic tudiz podrzi dole `HALT`
		* (CPU je v haltu a zacne nabihat jeho reset, vsechny signaly v HiZ)
		* (ATmega2560 staruje a ma vsechny piny HiZ)
		* (GLUE po resetu odpojilo brany k Arduinu)
	* Clock se rozbiha na nejakych 4 MHz
* po delsi dobe nastartuje ATmega2560 (veci v setup a tak)
	* `A_HALT` nastavi na **LOW** a aktivne ho tam drzi (zadna zmena)
	* ATmega2560 nacte z SD karty, nebo FLASH, nebo nejak obsah ROM
#comm_end
#msg MHF nabootovalo a aktivne prebira A_HALT a vsechny ostatni sve piny (ale zatim zadna zmena)
#msg MHF nacte z SD karty, nebo FLASH, nebo nejak obsah ROM
#msg pri in_HALT_mode ma MHF gate rizene A_SHARE_SELECT & A_SHARE_REQUEST (pokud neni druhe v poradi) (A_G_ENABLE=H B_G_ENABLE=H):
#msg Zatim jsme nepozadali o aktivaci (A_SHARE_REQUEST), tak jsou zavrene
#set A_HALT=0 // ATmega2560 sets
#set A_G_ENABLE=H
#set B_G_ENABLE=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#call clock(L,H) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------


#// {{{ MHFA in_HALT_mode
#msg MHFA zacne plnit SystemRAM
#msg nejdriv pro jistotu nastavim A_READ=1, aby se SystemRAM nahodile nemazala (MHF ma data HiZ)
#set A_READ=1 // ATmega2560 sets
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Plan: Zapsat(treba na '1 FFFF') nejaka data (treba 5A) A_SHARE_SELECT=0 (manage SystemRAM) + A_SHARE_REQUEST=1 (Wants to own) (=>A_SHARE_GRANTED=1)
#msg A_SHARE_SELECT=0
#set A_SHARE_SELECT=0 // ATmega2560 sets
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg A_SHARE_REQUEST=1 => A_G_ENABLE active
#set A_SHARE_REQUEST=1 // ATmega2560 sets
#set A_G_ENABLE=L
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Should have A_SHARE_GRANTED=H (test it)
#set A_SHARE_GRANTED=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg mam A_HALT, dostal jsem A_SHARE_GRANTED=1 + A_SHARE_COOP=1 => muzu pouzivat SystemRAM
#set A_SHARE_COOP=H
#msg ########################################
#msg  nastavim A_READ=1 (=> ctu SystemRAM, to je pro ni OK, MHF dostava data, ale ATmega ma data=HiZ a SharedRAM.CS (A_S_SELECT) neni active), nastavim CADDR/GADDR, nastavim A_S_16 pro spravnou pulku
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#set A_READ=1 // ATmega2560 sets
#set CADDR='FFFF' // ATmega2560 sets
#set GADDR='F' // ATmega2560 sets
#set A_S_16 = 1 // ATmega2560 sets
#set GA16 = H // z A_S_16
#set A_S_SELECT=H // overeni, ze si neskodim
#call blind_write(A,5A) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ########################################
#msg MHF da data HiZ, nastavi dalsi adresu, zapise dalsi byte a tak porad dokola
#msg nastavim A_READ=1 (=> ctu SystemRAM, to je pro ni OK, MHF ma data=HiZ), nastavim CADDR/GADDR
#set A_READ=1
#set CADDR='FFFE'
#set GADDR='F'
#set A_S_16 = 1
#set GA16 = H
#call blind_write(A,49) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ########################################
#msg dokud nejsou vsechna data zapsana
#msg test zapisu do oblasti registru (pisu do SystemRAM)
#set CADDR='A000'
#set GADDR='A'
#set A_S_16 = 0
#set GA16 = L
#call blind_write(A,12) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg test zapisu do oblasti EMS1 (pisu do SystemRAM)
#set CADDR='8000'
#set GADDR='8'
#set A_S_16 = 0
#set GA16 = L
#call blind_write(A,34) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg test zapisu do oblasti EMS2 (pisu do SystemRAM)
#set CADDR='9000'
#set GADDR='9'
#set A_S_16 = 0
#set GA16 = L
#call blind_write(A,56) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ########################################
#msg ### clear SharedRAM
#msg ########################################
#msg Cil: A_S_16=Z, gates closed, Shared=active, A_S_READ/A_S_WRITE podle A_READ, A_S_SELECT active, MHF si muze psat co chce
#msg A_SHARE_SELECT=1 (manage SharedRAM) => RAM_Sel NOT active, A_G_ENABLE NOT active, SharedRAM active
#msg A_S_16 je ovladan ATmega2560 a pouzivan pro pristup k lokalni SharedRAM primo, jedine co muzeme udelat je ho ignorovat == drzet RAM_Sel not active, dokud se neuplatni B_S_16, nebo neskonci in_HALT_mode
#set A_SHARE_SELECT=1
#set A_S_16=1 // ~ nahodne se menici hodnota
#set GA16=*
#set Rw=*
#set A_G_D_DIR=* // ~ nevim, co tu bude, ale protoze se RAM_Sel neaktivuje (ani nic jineho), tak je to jedno - MHFA si pise pro sebe
#set RAM_Sel=H
#set A_G_ENABLE=H
#set A_S_SELECT=L
#set A_READ=1
#set DATA="Z"
#set CADDR="Z"
#set GADDR="Z"
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#call clock(L,H) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg zapis do lokalni SharedRAM primo: vybrana je podle A_SHARE_REQUEST, A_READ nastavuje A_S_READ a A_S_WRITE
#msg A_SHARE_REQUEST=0 vypnu A_S_SELECT
#set A_SHARE_REQUEST=0
#set A_S_SELECT=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ATmega2560 si nastavi si SharedAddressA0..15 a B_S_16 podle potreby, pak si zapne data
#msg pak nastavi A_READ=0 , zatin se nic nedeje, neni A_S_SELECT
#set A_READ=0
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ted nastavi A_SHARE_REQUEST=1 => A_S_SELECT se aktivuje a tim zapise spravnou hodnotu
#set A_SHARE_REQUEST=1
#set A_S_SELECT=L
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg pocka jeden takt, shodi A_SHARE_REQUEST a dal muze menit A_READ, data a adresy po libosti 
#msg A_SHARE_REQUEST=0 vypnu A_S_SELECT
#set A_SHARE_REQUEST=0
#set A_S_SELECT=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ATmega2560 si da data HiZ a muze nastavit dalsi adresu a opakovat
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg uklidime si vystupy:
#set A_SHARE_REQUEST=0
#set A_READ=1
#set A_SHARE_SELECT=0
#msg tady se jeste da vratit i k zapisu do SystemRAM a tocit se v kruhu
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
