#// {{{ MHFB in_HALT_mode
#msg MHFB zacne plnit SystemRAM
#msg nejdriv pro jistotu nastavim B_READ=1, aby se SystemRAM nahodile nemazala (MHF ma data HiZ)
#set B_READ=1 // ATmega2560 sets
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Plan: Zapsat(treba na '1 FFFF') nejaka data (treba 5A) B_SHARE_SELECT=0 (manage SystemRAM) + B_SHARE_REQUEST=1 (Wants to own) (=>B_SHARE_GRANTED=1)
#msg B_SHARE_SELECT=0
#set B_SHARE_SELECT=0 // ATmega2560 sets
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg B_SHARE_REQUEST=1 => B_G_ENABLE active
#set B_SHARE_REQUEST=1 // ATmega2560 sets
#set B_G_ENABLE=L
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg Should have B_SHARE_GRANTED=H (test it)
#set B_SHARE_GRANTED=H
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg mam B_HALT, dostal jsem B_SHARE_GRANTED=1 + B_SHARE_COOP=1 => muzu pouzivat SystemRAM
#set B_SHARE_COOP=H
#msg ########################################
#msg  nastavim B_READ=1 (=> ctu SystemRAM, to je pro ni OK, MHF dostava data, ale ATmega ma data=HiZ a SharedRAM.CS (B_S_SELECT) neni active), nastavim CADDR/GADDR, nastavim B_S_16 pro spravnou pulku
#gen_vector //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#set B_READ=1 // ATmega2560 sets
#set CADDR='FFFF' // ATmega2560 sets
#set GADDR='F' // ATmega2560 sets
#set B_S_16 = 1 // ATmega2560 sets
#set GA16 = H // z B_S_16
#set B_S_SELECT=H // overeni, ze si neskodim
#call blind_write(B,5A) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ########################################
#msg MHF da data HiZ, nastavi dalsi adresu, zapise dalsi byte a tak porad dokola
#msg nastavim B_READ=1 (=> ctu SystemRAM, to je pro ni OK, MHF ma data=HiZ), nastavim CADDR/GADDR
#set B_READ=1
#set CADDR='FFFE'
#set GADDR='F'
#set B_S_16 = 1
#set GA16 = H
#call blind_write(B,49) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg ########################################
#msg dokud nejsou vsechna data zapsana
#msg test zapisu do oblasti registru (pisu do SystemRAM)
#set CADDR='A000'
#set GADDR='A'
#set B_S_16 = 0
#set GA16 = L
#call blind_write(B,12) //  ----------------------------------------------------------------------------------------------------------------------------------------------------------------
#msg test zapisu do oblasti EMS1 (pisu do SystemRAM)
#set CADDR='8000'
#set GADDR='8'
#set B_S_16 = 0
#set GA16 = L
