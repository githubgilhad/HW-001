#set BA=0 /* protoze uz neni HALT */
#set GADDR="*"
#set A_SHARE_GRANTED=L
#set B_SHARE_GRANTED=L
#set A_SHARE_COOP=L
#set B_SHARE_COOP=L
#set A_G_A_DIR=*
#set B_G_A_DIR=*
#msg MHFB uz je v normalnim stavu
#msg NOTE: uz neni in_HALT_mode => OBE MHF maji ?_SHARE_GRANTED=L (a ?_SHARE_COOP=L, ale to uz muze CPU casem zmenit)
