	Pin 53 = NC;
	Pin 55 = NC;
	Pin 59 = GND;
	Pin 62 = TCK;  
	Pin 66 = VCC;
	Pin 70 = NC;
	Pin 72 = NC;
	Pin 73 = TDO;  
	Pin 74 = GND;
	Pin 77 = NC;
	Pin 78 = NC;
	Pin 82 = VCC;
	Pin 86 = GND;
	Pin 91 = VCC;
	Pin 95 = GND;
	
	***** I/O pins *****
	
	Pin 6  = IO_1; 
	Pin 8  = IO_2; 
	Pin 9  = IO_3; 
	Pin 10 = IO_4; 
	Pin 12 = IO_5; 
	Pin 13 = IO_6; 
	Pin 14 = IO_7; 
	Pin 16 = IO_8;  
	Pin 17 = IO_9;  
	Pin 19 = IO_10;  
	Pin 20 = IO_11;  
	Pin 21 = IO_12;  
	Pin 23 = IO_13;  
	Pin 25 = IO_14;  
	Pin 29 = IO_15;  
	Pin 30 = IO_16;  
	Pin 31 = IO_17;  
	Pin 32 = IO_18;  
	Pin 33 = IO_19;  
	Pin 35 = IO_20;  
	Pin 36 = IO_21;  
	Pin 37 = IO_22;  
	Pin 40 = IO_23;  
	Pin 41 = IO_24;  
	Pin 42 = IO_25;  
	Pin 44 = IO_26;  
	Pin 45 = IO_27;  
	Pin 46 = IO_28;  
	Pin 47 = IO_29;  
	Pin 48 = IO_30;  
	Pin 52 = IO_31;  
	Pin 54 = IO_32;  
	Pin 56 = IO_33;  
	Pin 57 = IO_34;  
	Pin 58 = IO_35;  
	Pin 60 = IO_36;  
	Pin 61 = IO_37;  
	Pin 63 = IO_38;  
	Pin 64 = IO_39;  
	Pin 65 = IO_40;  
	Pin 67 = IO_41;  
	Pin 68 = IO_42;  
	Pin 69 = IO_43;  
	Pin 71 = IO_44;  
	Pin 75 = IO_45;  
	Pin 76 = IO_46;  
	Pin 79 = IO_47;  
	Pin 80 = IO_48;  
	Pin 81 = IO_49;  
	Pin 83 = IO_50;  
	Pin 84 = IO_51;  
	Pin 92 = IO_53;  
	Pin 93 = IO_54;  
	Pin 94 = IO_55;  
	Pin 96 = IO_56;  
	Pin 97 = IO_57;  
	Pin 98 = IO_58;  
	Pin 99 = IO_59;  
	Pin 100 = IO_60; 
	
	***** Input Only ****
	
	Pin 85 = IO_52;  /* INPUT/GCLK3 /
	Pin 87 = xIO_61; /* INPUT/GCLK1 /
	Pin 88 = xIO_62; /* INPUT/OE1 - 12V Vpp/
	Pin 89 = xIO_63; /* INPUT/GCLR /
	Pin 90 = xIO_64; /* INPUT/OE2/GCLK2 /
	
	 }}} */
	
	/************************************************************/
	/* REG7 ROM_SIZE                                            */
	/************************************************************/
	NODE [ROM_SIZE2..0];
	FIELD ROM_SIZE = [ROM_SIZE2..0];
	
	/* 
	
	4+ = vypnuto
	3 = 4k
	2 = 8k
	1 = 16k
	0 = 24.75 kB
	*/
	/************************************************************/
	
	FIELD CA = [CA15..CA0];
	
	/************************************************************/
	/* ADDRESS DECODE                                           */
	/************************************************************/
	
	NATIVE_RAM_LO = CA:[0000..7FFF];
	
	EMS1_WINDOW = CA:[8000..8FFF];
	
	EMS2_WINDOW = CA:[9000..9FFF];
	
	/* ATF2 registry */
	REG0 = (CA:A000); /* EMS1_PAGE */
	REG1 = (CA:A001); /* EMS1_STATUS */
	REG2 = (CA:A002); /* EMS2_PAGE */
	REG3 = (CA:A003); /* EMS2_STATUS */
	REG4 = (CA:A004); /* CHIPA_STATUS */
	REG5 = (CA:A005); /* CHIPB_STATUS */
	
	REG_MIRROR = CA:[A006..A01F]; 
	/* nasleduji ATF1 registry */
	REG6 = (CA:A006); /* ROM_STATUS */
	REG7 = (CA:A007); /* ROM_SIZE */
	
	DEVICE_AREA = CA:[A020..A0FF];
	
	ROM_24K = CA:[A100..FFFF];
	ROM_16K = CA:[C000..FFFF];
	ROM_8K  = CA:[E000..FFFF];
	ROM_4K  = CA:[F000..FFFF];
	
	
	ROM_AREA = 
		RomMapped & 
		(
			  ((ROM_SIZE:0) & ROM_24K)
			# ((ROM_SIZE:1) & ROM_16K)
			# ((ROM_SIZE:2) & ROM_8K)
			# ((ROM_SIZE:3) & ROM_4K)
			/* ROM_SIZE 4+ == zadna ROM */
		)
		;
	
	NATIVE_RAM_HI = ROM_24K & !ROM_AREA;
	
	
	
	
	
	/************************************************************/
	/* MEMORY REGION BUS                                        */
	/************************************************************/
	
	MR0 = !BA & (
		  EMS1_WINDOW
		# ROM_AREA
		# REG1
		# REG3
		# REG5
		# REG_MIRROR
		);
	
	MR1 = !BA & (
		  EMS2_WINDOW
		# ROM_AREA
		# REG2
		# REG3
		# REG_MIRROR
		);
	
	MR2 = !BA & (
		  DEVICE_AREA
		# REG4
		# REG5
		# REG_MIRROR
		);
	
	MR3 = !BA & (
		  REG0
		# REG1
		# REG2
		# REG3
		# REG4
		# REG5
		# REG_MIRROR
		);
	
	/*
		HALT/BA active	MR = 0; 	0000  // pri HALTu je vsechno RAM
	
		NATIVE_RAM_LO	MR = 0; 	0000
		NATIVE_RAM_HI	MR = 0; 	0000
		EMS1_WINDOW	MR = 1; 	0001
		EMS2_WINDOW	MR = 2; 	0010
		
		REG0		MR = 8; 	1000
		REG1		MR = 9; 	1001
		REG2		MR = 10; 	1010
		REG3		MR = 11; 	1011
		REG4		MR = 12; 	1100
		REG5		MR = 13; 	1101
		
		REG_MIRROR	MR = 15; 	1111
		
		DEVICE_AREA	MR = 4; 	0100
		
		ROM_AREA	MR = 3; 	0011
	*/
	
	/************************************************************/
	/* READ / WRITE                                             */
	/************************************************************/
	
	Read  = E &  Rw;
	Write = E & !Rw;
	
	/************************************************************/
	/* DEVICE SELECTS                                           */
	/************************************************************/
	
	/*
	 * EMS windows:
	 *   ATF1 releases DEV0
	 *   ATF2 drives DEV0
	 */
	
	RAM 		= NATIVE_RAM_LO 
			# NATIVE_RAM_HI 
			;
	
	ROM		= ROM_AREA;
	
	EMS_WINDOW 	= EMS1_WINDOW # EMS2_WINDOW;
	
	RAM.OE	= !EMS_WINDOW & !BA; /* managed by ATF2 */
	ROM.OE	= !EMS_WINDOW & !BA; /* managed by ATF2 */
	
	/************************************************************/
	/* DEVICE BLOCK                                             */
	/************************************************************/
	
	Dev_Sel_1 = CA:[A020..A03F] & !BA;
	Dev_Sel_2 = CA:[A040..A05F] & !BA;
	Dev_Sel_3 = CA:[A060..A07F] & !BA;
	Dev_Sel_4 = CA:[A080..A09F] & !BA;
	Dev_Sel_5 = CA:[A0A0..A0BF] & !BA;
	Dev_Sel_6 = CA:[A0C0..A0DF] & !BA;
	Dev_Sel_7 = CA:[A0E0..A0FF] & !BA;
	
	
	/************************************************************/
	/* ATF1 Registers Write                                     */
	/************************************************************/
	
	/************************************************************/
	/* REG6 ROM_STATUS                                          */
	/************************************************************/
	
	/* RomMapped se pri resetu nastavi na BootSrc,
		pri zapisu zmeni hodnotu na zapsanou */
	/*
	RomMapped.d =
	       Reset & BootSrc
	    # !Reset & D0;
	
	RomMapped.CK = E;
	RomMapped.CE =    Reset 
			# REG6 & !Rw;
	
	*/
	
	RomMapped.d = D0;
	
	RomMapped.CK = !Q;
	RomMapped.AR = Reset & !BootSrc;
	RomMapped.AP = Reset & BootSrc;
	RomMapped.CE = REG6 & !Rw & !BA;
	
	
	/************************************************************/
	/* REG7 ROM_SIZE                                            */
	/************************************************************/
	
	ROM_SIZE.d=[D2..D0];
	
	ROM_SIZE.CK=!Q;
	ROM_SIZE.AR=Reset;
	ROM_SIZE.CE = REG7 & !Rw & !BA;
	
	
	/************************************************************/
	/* ATF1 Registers Read                                      */
	/************************************************************/
	
	[D7..D0].OE = E & Rw & ( REG6 # REG7 ) & !BA; /* write full D */
	
	[D7..D3] = E & !E;		/* 0 for unused */
	
	[D2]  = REG7 & ROM_SIZE2
		# REG6 & !REG6; 		/* 0 for REG6 */
	
	[D1]  = REG7 & ROM_SIZE1
		# REG6 & BootSrc;
	
	[D0]  = REG7 & ROM_SIZE0
		# REG6 & RomMapped;
	
	/*
	NOTE to AI about syntax: in "PIN xx = !NAME" the exclamation mark means, that signal is active low (0V) and inactive high (+5V), so
	PIN 6 = !A;
	PIN 8 = !B;
	Pin 9 = !C; // = 3 active low signals 
	C = A & B; // means C is active (=0V) when (and only when) A is active (=0V) AND B is active (=0V) and the compiler translates it to formula PIN 9 = PIN 6 # PIN 8
	It makes easy to works with active low signals (like Chip Enable), where the equation goes stright Chip is Enable = true mean it is enabled ...
	*/
	/*
	Skutecna jmena signalu a cisla pinu, pokud je pred jmenem !, je signal aktivni v LOW:
	*/
	/************************************************************/
	/* SOME DECLARATION - need to check {{{                     */
	/************************************************************/
	
	
	TRUE = E # !E;
	FALSE = E & !E;
	
	/************************************************************/
	/* FIELDS                                                   */
	/************************************************************/
	
	FIELD MR = [MR3..MR0];
	
	FIELD EMS1_PAGE = [EMS1_A1, EMS1_A0, EMS1_B4, EMS1_B3, EMS1_B2, EMS1_B1, EMS1_B0];
	FIELD EMS2_PAGE = [EMS2_A1, EMS2_A0, EMS2_B4, EMS2_B3, EMS2_B2, EMS2_B1, EMS2_B0];
	
	/* data from CPU */
	FIELD DATA = [D7..D0];
	
	
	/************************************************************/
	/* INTERNAL NODES                                           */
	/************************************************************/
	
	/* EMS1 mapping */
	
	NODE EMS1_A1;
	NODE EMS1_A0;
	
	NODE EMS1_B4;
	NODE EMS1_B3;
	NODE EMS1_B2;
	NODE EMS1_B1;
	NODE EMS1_B0;
	
	/* EMS2 mapping */
	
	NODE EMS2_A1;
	NODE EMS2_A0;
	
	NODE EMS2_B4;
	NODE EMS2_B3;
	NODE EMS2_B2;
	NODE EMS2_B1;
	NODE EMS2_B0;
	
	
	/************************************************************/
	/* Chip ownership/state                                     */
	/************************************************************/
	
	/*
	A = owned by MHF
	C = owned by CPU
	Dc, Dm = dirty (from viewpoint of CPU or MHF)
	*/
	
	NODE CHIPA_A;
	NODE CHIPA_C;
	NODE CHIPA_Dc;
	NODE CHIPA_Dm;
	
	NODE CHIPB_A;
	NODE CHIPB_C;
	NODE CHIPB_Dc;
	NODE CHIPB_Dm;
	
	
	/************************************************************/
	/* Derived signals                                          */
	/************************************************************/
	
	NODE EMS1_is_SYS;
	NODE EMS1_is_MHFA;
	NODE EMS1_is_MHFB;
	NODE EMS1_is_ROM;
	
	NODE EMS2_is_SYS;
	NODE EMS2_is_MHFA;
	NODE EMS2_is_MHFB;
	NODE EMS2_is_ROM;
	
	
	NODE CHIPA_W;
	NODE CHIPB_W;
	
	NODE CPU_WANTS_A;
	NODE CPU_WANTS_B;
	
	NODE CPU_USES_A;
	NODE CPU_USES_B;
	
	NODE HALT_MODE;
	
	NODE REG_ACCESS;
	NODE REG_READ;
	NODE REG_WRITE;
	
	NODE EMS_WINDOW;
	NODE ROM_WINDOW;
	NODE RAM_WINDOW;
	
	NODE ACTIVE_PAGE_A1;
	NODE ACTIVE_PAGE_A0;
	
	NODE ACTIVE_B4;
	NODE ACTIVE_B3;
	NODE ACTIVE_B2;
	NODE ACTIVE_B1;
	NODE ACTIVE_B0;
	
	/* }}} */
	/************************************************************/
	/* CONSTANT DECODE - need to check {{{                      */
	/************************************************************/
	
	RAM_WINDOW =
	       (MR:0);
	
	EMS_WINDOW =
	       (MR:1)
	    #  (MR:2);
	
	ROM_WINDOW =
	       (MR:3);
	
	/* MR:8 .. MR:D - registers */
	REG_ACCESS = 
		   (MR:[8..D])
		 & E; 
	REG_READ = 
		REG_ACCESS 
		& Rw ; 
	REG_WRITE = 
		REG_ACCESS 
		& !Rw ;
	/*
	REG_READ  = E & !BA &  Rw & (MR:[8..D]);
	REG_WRITE = E & !BA & !Rw & (MR:[8..D]);
	*/
	
	/************************************************************/
	/* Decode current mapping                                   */
	/************************************************************/
	
	EMS1_is_SYS  = !EMS1_A1 & !EMS1_A0;
	EMS1_is_MHFA = !EMS1_A1 &  EMS1_A0;
	EMS1_is_MHFB =  EMS1_A1 & !EMS1_A0;
	EMS1_is_ROM  =  EMS1_A1 &  EMS1_A0;
	
	EMS2_is_SYS  = !EMS2_A1 & !EMS2_A0;
	EMS2_is_MHFA = !EMS2_A1 &  EMS2_A0;
	EMS2_is_MHFB =  EMS2_A1 & !EMS2_A0;
	EMS2_is_ROM  =  EMS2_A1 &  EMS2_A0;
	
	
	/* }}} */
	/************************************************************/
	/* REG0 EMS1 PAGE {{{   (A[1..0] x B[4..0])              OK */
	/************************************************************/
	/*
	D7 D6 = AA
	D5 = reserved
	D4..D0 = BBBBB
	*/
	
	EMS1_A1.D = D7;
	EMS1_A0.D = D6;
	
	EMS1_B4.D = D4;
	EMS1_B3.D = D3;
	EMS1_B2.D = D2;
	EMS1_B1.D = D1;
	EMS1_B0.D = D0;
	/*
	AA:
	
	00 System RAM
	01 MHF_A
	10 MHF_B
	11 invalid/ROM TODO
	*/
	
	
	/* spolecne rizeni 0.25 tact */
	
	EMS1_A1.CK = !Q;
	EMS1_A0.CK = !Q;
	
	EMS1_B4.CK = !Q;
	EMS1_B3.CK = !Q;
	EMS1_B2.CK = !Q;
	EMS1_B1.CK = !Q;
	EMS1_B0.CK = !Q;
	
	EMS1_A1.AR = Reset;
	EMS1_A0.AR = Reset;
	
	/* EMS1_B4.AR = Reset;	 default $8000 */
	EMS1_B4.AR = Reset;
	EMS1_B3.AP = Reset;
	EMS1_B2.AR = Reset;
	EMS1_B1.AR = Reset;
	EMS1_B0.AR = Reset;
	
	EMS1_A1.CE = REG_WRITE & (MR:8);
	EMS1_A0.CE = REG_WRITE & (MR:8);
	
	EMS1_B4.CE = REG_WRITE & (MR:8);
	EMS1_B3.CE = REG_WRITE & (MR:8);
	EMS1_B2.CE = REG_WRITE & (MR:8);
	EMS1_B1.CE = REG_WRITE & (MR:8);
	EMS1_B0.CE = REG_WRITE & (MR:8);
	
	/* }}} */
	/************************************************************/
	/* REG2 EMS2 PAGE {{{ (A[1..0] x B[4..0])               OK  */
	/************************************************************/
	
	/*
	D7 D6 = AA
	D5 = reserved
	D4..D0 = BBBBB
	*/
	
	EMS2_A1.D = D7;
	EMS2_A0.D = D6;
	
	EMS2_B4.D = D4;
	EMS2_B3.D = D3;
	EMS2_B2.D = D2;
	EMS2_B1.D = D1;
	EMS2_B0.D = D0;
	/*
	AA:
	
	00 System RAM
	01 MHF_A
	10 MHF_B
	11 invalid/ROM TODO
	*/
	
	EMS2_A1.CK = !Q;
	EMS2_A0.CK = !Q;
	
	EMS2_B4.CK = !Q;
	EMS2_B3.CK = !Q;
	EMS2_B2.CK = !Q;
	EMS2_B1.CK = !Q;
	EMS2_B0.CK = !Q;
	
	EMS2_A1.AR = Reset;
	EMS2_A0.AR = Reset;
	
	EMS2_B4.AR = Reset;	/* default $9000 */
	EMS2_B3.AP = Reset;
	EMS2_B2.AR = Reset;
	EMS2_B1.AR = Reset;
	EMS2_B0.AP = Reset;
	
	EMS2_A1.CE = REG_WRITE & (MR:A);
	EMS2_A0.CE = REG_WRITE & (MR:A);
	
	EMS2_B4.CE = REG_WRITE & (MR:A);
	EMS2_B3.CE = REG_WRITE & (MR:A);
	EMS2_B2.CE = REG_WRITE & (MR:A);
	EMS2_B1.CE = REG_WRITE & (MR:A);
	EMS2_B0.CE = REG_WRITE & (MR:A);
	
	
	/* }}} */
	/* SUPERVISED part BEGIN {{{ */
	/************************************************************/
	/* HALT mode                                                */
	/************************************************************/
	
	HALT =	   A_HALT # B_HALT;
	HALT.OE =  A_HALT # B_HALT; /* enabled if driven by us */
	
	/* nasledne se aktivuje BA behem nekolika taktu a tim se odpoji sbernice od CPU */
	
	/* Rw je ovladan CPU, vyjma HALT rezimu, kdy to prevezme ATF2 a ridi se dle MHF_x */
	Rw =	  !A_READ & A_HALT
		# !B_READ & B_HALT & !A_HALT; /* directed by A primary, or B secondary */
	Rw.OE =	  BA; /* driven only in HALT mode */
	
	/************************************************************/
	/* SYSTEM RAM SELECT                                        */
	/************************************************************/
	/* RAM je bezne ovladan ATF1, s vyjimkou HALT rezimu a EMS oken, kdy to prevezme ATF2 a ridi se dle MHF_x a nastaveni EMS  */
	RAM =	  BA                /* v HALT rezimu je RAM vybrana permanentne */
		# (MR:1) & EMS1_is_SYS /* Sys RAM selected in EMS1 */
		# (MR:2) & EMS2_is_SYS /* Sys RAM selected in EMS2 */
		;
	RAM.OE =   BA
		# (MR:1)
		# (MR:2)
		;
	
	/* ROM je  bezne ovladan ATF1, s vyjimkou HALT rezimu (kde vybran neni) a EMS oken, kdy to prevezme ATF2 a ridi se dle MHF_x a nastaveni EMS  */
	ROM = 	
		  (MR:1) & EMS1_is_ROM 
		# (MR:2) & EMS2_is_ROM
		/* or FALSE in HALT/BA */
		;
	ROM.OE =  BA
		# (MR:1)
		# (MR:2)
		;
	
	/*  IO connected to SharedRAM.A16 and MHF MCU */
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */ /* TODO GA16 */
	A_S_16 = 	  (MR:1) & EMS1_is_MHFA & CHIPA_C & EMS1_B4
			# (MR:2) & EMS2_is_MHFA & CHIPA_C & EMS2_B4
			;
	A_S_16.OE = 	  (MR:1) & EMS1_is_MHFA & CHIPA_C 
			# (MR:2) & EMS2_is_MHFA & CHIPA_C 
			;
	
	/*  IO connected to SharedRAM.A16 and MHF MCU */
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */ /* TODO GA16 */
	B_S_16 = 	  (MR:1) & EMS1_is_MHFB & CHIPB_C & EMS1_B4
			# (MR:2) & EMS2_is_MHFB & CHIPB_C & EMS2_B4
			;
	B_S_16.OE = 	  (MR:1) & EMS1_is_MHFB & CHIPB_C 
			# (MR:2) & EMS2_is_MHFB & CHIPB_C 
			;
	/* O Dirty+Wanted+BA: BA?1:if(SHARE_GRANTED){WANTS:1=CPU wants SharedRAM}else{DIRTY:1=CPU already got SharedRAM} */
	/* in HALT state 1= writing SystemRAM is possible
	 * if SHARE_GRANTED 1= CPU already wants SharedRAM (=please release it soon)
	 * if !SHARE_GRANTED 1 = CPU already got SharedRAM (=and maybe modified it)
	 * 0 = nothing special
	 */
	A_SHARE_DIRTY =	  BA
			# A_SHARE_GRANTED & ( EMS1_is_MHFA # EMS2_is_MHFA )
			# !A_SHARE_GRANTED & CHIPA_Dm
			;
	B_SHARE_DIRTY =	  BA & !A_HALT /* write if MHF_A released it alredy */
			# B_SHARE_GRANTED & ( EMS1_is_MHFB # EMS2_is_MHFB )
			# !B_SHARE_GRANTED & CHIPB_Dm
			;
	A_SHARE_GRANTED =	A_SHARE_REQUEST & CHIPA_A;
	B_SHARE_GRANTED =	B_SHARE_REQUEST & CHIPB_A;
	
	/************************************************************/
	/* OWNERSHIP CHIP_xx FIXME: dole je lepsi {{{            OK */
	/************************************************************/
	/*
	CHIPA_C.d =
			  EMS1_is_MHFA & !CHIPA_A
			# EMS2_is_MHFA & !CHIPA_A 
			# EMS1_is_MHFA &  CHIPA_C
			# EMS2_is_MHFA &  CHIPA_C
			;
	CHIPB_C.d =
			  EMS1_is_MHFB & !CHIPB_A
			# EMS2_is_MHFB & !CHIPB_A
			# EMS1_is_MHFB &  CHIPB_C
			# EMS2_is_MHFB &  CHIPB_C
			;
	
	CHIPA_C.CK = !E;
	CHIPB_C.CK = !E; 
	
	CHIPA_A.d =
			  A_SHARE_REQUEST & !CHIPA_C 
			# A_SHARE_REQUEST &  CHIPA_A
			;
	CHIPB_A.d =
			  B_SHARE_REQUEST & !CHIPB_C
			# B_SHARE_REQUEST &  CHIPB_A
			;
	CHIPA_A.CK = Q;
	CHIPB_A.CK = Q; 
	*/
	/* }}} */
	/************************************************************/
	/* Dirty flags                                       {{{ OK */
	/************************************************************/
	
	CHIPA_Dc.d = 
			  CHIPA_A
			# CHIPA_Dc & !CHIPA_C;
	CHIPA_Dc.CK = E; /* 0.0 tact, az po CHIPA_A a CHIPA_C, a pred zapisem registru, na pocatku cteni, takze CPU uz cte pripadne novou hodnotu  */ 
	
	CHIPA_Dm.d = 
			  CHIPA_C
			# CHIPA_Dm & !CHIPA_A;
	CHIPA_Dm.CK = E; /* 0.0 tact, az po CHIPA_A a CHIPA_C, a pred zapisem registru, na pocatku cteni, takze CPU uz cte pripadne novou hodnotu  */ 
	
	CHIPB_Dc.d = 
			  CHIPB_A
			# CHIPB_Dc & !CHIPB_C;
	CHIPB_Dc.CK = E; /* 0.0 tact, az po CHIPB_A a CHIPB_C, a pred zapisem registru, na pocatku cteni, takze CPU uz cte pripadne novou hodnotu  */ 
	
	CHIPB_Dm.d = 
			  CHIPB_C
			# CHIPB_Dm & !CHIPB_A;
	CHIPB_Dm.CK = E; /* 0.0 tact, az po CHIPB_A a CHIPB_C, a pred zapisem registru, na pocatku cteni, takze CPU uz cte pripadne novou hodnotu  */ 
	
	/* }}} */
	/************************************************************/
	/* REGISTERS READ  {{{                                OK    */
	/************************************************************/
	/* REG0 */
	
	[D7..D0].OE = REG_READ;
	
	D7 =  REG_READ & (
		  (MR:8)  & EMS1_A1
		# (MR:A) & EMS2_A1
		);
	
	D6 =  REG_READ & (
		  (MR:8)  & EMS1_A0
		# (MR:A) & EMS2_A0
		);
	
	D5 =  REG_READ & (
		/*  (MR:8) & FALSE ) */
		FALSE
		);
	
	D4 =  REG_READ & (
		  (MR:8)  & EMS1_B4
		# (MR:A) & EMS2_B4
		);
	D3 =  REG_READ & (
		  (MR:8)  & EMS1_B3
		# (MR:A) & EMS2_B3
		# (MR:C) & CHIPA_Dc
		# (MR:D) & CHIPB_Dc
		);
	D2 =  REG_READ & (
		  (MR:8) & EMS1_B2
		# (MR:9) & EMS1_W
		# (MR:A) & EMS2_B2
		# (MR:B) & EMS2_W
		# (MR:C) & CHIPA_W
		# (MR:D) & CHIPB_W
		);
	D1 =  REG_READ & (
		  (MR:8) & EMS1_B1
		# (MR:A) & EMS2_B1
		# (MR:C) & CHIPA_A
		# (MR:D) & CHIPB_A
		);
	D0 =  REG_READ & (
		  (MR:8) & EMS1_B0
		# (MR:9) & EMS1_C
		# (MR:A) & EMS2_B0
		# (MR:B) & EMS2_C
		# (MR:C) & CHIPA_C
		# (MR:D) & CHIPB_C
		);
	/* }}} */


	/************************************************************/
	/* EMS STATUS                                        OK {{{ */
	/************************************************************/
	
	EMS1_C = /* owned by CPU */
		  EMS1_is_SYS
		# EMS1_is_MHFA & CHIPA_C
		# EMS1_is_MHFB & CHIPB_C
		# EMS1_is_ROM
		;
	
	
	EMS2_C =
		  EMS2_is_SYS
		# EMS2_is_MHFA & CHIPA_C
		# EMS2_is_MHFB & CHIPB_C
		# EMS2_is_ROM
		;
	
	EMS1_W = /* Wanted by card */
		  EMS1_is_MHFA & A_SHARE_REQUEST
		# EMS1_is_MHFB & B_SHARE_REQUEST
		;
	
	EMS2_W = /* Wanted by card */
		  EMS2_is_MHFA & A_SHARE_REQUEST
		# EMS2_is_MHFB & B_SHARE_REQUEST
		;
	/* }}} */
	/************************************************************/
	/* MHF wants which chip                              OK {{{ */
	/************************************************************/
	
	CHIPA_W = A_SHARE_REQUEST;
	CHIPB_W = B_SHARE_REQUEST;
	
	/* }}} */
	/************************************************************/
	/* CPU / MHF requests                                OK {{{ */
	/************************************************************/
	
	CPU_REQ_A = 
	      EMS1_is_MHFA
	   #  EMS2_is_MHFA;
	CPU_REQ_B = 
	      EMS1_is_MHFB
	   #  EMS2_is_MHFB;
	
	
	MHF_REQ_A = A_SHARE_REQUEST;
	MHF_REQ_B = B_SHARE_REQUEST;
	
	/* }}} */
	/************************************************************/
	/* CHIP A ownership                                  {{{ OK */
	/************************************************************/
	
	/*
	Pravidla:
	
	00 -> nikdo
	
	10 -> CPU
	
	01 -> MHF
	
	11 -> zakazany stav
	
	Pokud chteji oba:
	
	- vlastnik zustava
	- pokud nebyl zadny -> CPU
	*/
	
	
	CHIPA_C.D =
	
	      ( CPU_REQ_A & !MHF_REQ_A )
	
	   #  ( CPU_REQ_A &  MHF_REQ_A & CHIPA_C )
	
	   #  ( CPU_REQ_A &  MHF_REQ_A & !CHIPA_C & !CHIPA_A );
	
	
	
	CHIPA_A.D =
	
	      ( MHF_REQ_A & !CPU_REQ_A )
	
	   #  ( CPU_REQ_A &  MHF_REQ_A & CHIPA_A );
	
	
	CHIPA_C.CK = !E; /* 0.5 tact */
	CHIPA_C.AR = Reset;
	CHIPA_C.CE = E # !E;
	
	CHIPA_A.CK = Q; /* 0.75 tact */
	CHIPA_A.AR = Reset;
	CHIPA_A.CE = E # !E;
	
	/* }}} */
	/************************************************************/
	/* CHIP B ownership                                  {{{ OK */
	/************************************************************/
	
	CHIPB_C.D =
	
	      ( CPU_REQ_B & !MHF_REQ_B )
	
	   #  ( CPU_REQ_B &  MHF_REQ_B & CHIPB_C )
	
	   #  ( CPU_REQ_B &  MHF_REQ_B & !CHIPB_C & !CHIPB_A );
	
	
	
	CHIPB_A.D =
	
	      ( MHF_REQ_B & !CPU_REQ_B )
	
	   #  ( CPU_REQ_B &  MHF_REQ_B & CHIPB_A );
	
	
	
	CHIPB_C.CK = !E; /* 0.5 tact */
	CHIPB_C.AR = Reset;
	CHIPB_C.CE = E # !E;
	
	CHIPB_A.CK = Q; /* 0.75 tact */
	CHIPB_A.AR = Reset;
	CHIPB_A.CE = E # !E;
	
	/* }}} */
	/************************************************************/
	/* EMS + GA <-> CA BLOK                              {{{ OK */
	/************************************************************/
	
	ACTIVE_PAGE_A1 =
	      (MR:1 & EMS1_A1)
	   #  (MR:2 & EMS2_A1);
	
	ACTIVE_PAGE_A0 =
	      (MR:1 & EMS1_A0)
	   #  (MR:2 & EMS2_A0);
	
	ACTIVE_B4 =
	      (MR:1 & EMS1_B4)
	   #  (MR:2 & EMS2_B4);
	
	ACTIVE_B3 =
	      (MR:1 & EMS1_B3)
	   #  (MR:2 & EMS2_B3);
	
	ACTIVE_B2 =
	      (MR:1 & EMS1_B2)
	   #  (MR:2 & EMS2_B2);
	
	ACTIVE_B1 =
	      (MR:1 & EMS1_B1)
	   #  (MR:2 & EMS2_B1);
	
	ACTIVE_B0 =
	      (MR:1 & EMS1_B0)
	   #  (MR:2 & EMS2_B0);
	
	
	/* Vyhodnoceni typu stranky */
	/************************************************************/
	/* ACTIVE SOURCE                                            */
	/************************************************************/
	ACTIVE_SYS  = !ACTIVE_PAGE_A1 & !ACTIVE_PAGE_A0;
	ACTIVE_MHFA = !ACTIVE_PAGE_A1 &  ACTIVE_PAGE_A0;
	ACTIVE_MHFB =  ACTIVE_PAGE_A1 & !ACTIVE_PAGE_A0;
	ACTIVE_ROM  =  ACTIVE_PAGE_A1 &  ACTIVE_PAGE_A0;
	
	/************************************************************/
	/* EMS ACCESS                                               */
	/************************************************************/
	
	EMS_ACCESS = /* jestli CPU ma pristup do EMS nebo neni spravne namapovana ... nevim, jestli to chci TODO nechci, ale viz -> */
	/* uvaha, kdyz CPU chce cist a nema pravo, tak dostane cokoli a nemusim se starat co. Kdyz chce psat a nema pravo, tak nezapise nikam. */
	/* uvaha2, kdyz CPU chce cist/psat do EMS, tak je cilovy chip vybran, ale pokud je to karta a nema pravo, tak jsou GATES zavrene, a neni obslouzeno, viz o kus nize */
		  ACTIVE_SYS
		# ACTIVE_ROM
		# (ACTIVE_MHFA & CHIPA_C)
		# (ACTIVE_MHFB & CHIPB_C);
	
	/************************************************************/
	/* EMS ADDRESS                                              */
	/************************************************************/
	
	GA16 = 
		  !BA &  ACTIVE_B4
		#  BA &  A_HALT & A_S_16 
		#  BA & !A_HALT & B_HALT & B_S_16 ; /* mimo EMS/boot nelze sahnout nad 64kB, a tedy GA16=0  */

	GA15 = EMS_WINDOW & ACTIVE_B3 # !EMS_WINDOW & CA15;
	GA14 = EMS_WINDOW & ACTIVE_B2 # !EMS_WINDOW & CA14;
	GA13 = EMS_WINDOW & ACTIVE_B1 # !EMS_WINDOW & CA13;
	GA12 = EMS_WINDOW & ACTIVE_B0 # !EMS_WINDOW & CA12;
	
/*	GA16.OE = !BA; */
	GA15.OE = !BA;
	GA14.OE = !BA;
	GA13.OE = !BA;
	GA12.OE = !BA;
	
	/* }}} */
	/************************************************************/
	/* SUPERVISED part ENDS }}}                                 */
	/************************************************************/
	
	/************************************************************/
	/* SHARED CHIP SELECT                                {{{ OK */
	/************************************************************/
	
	A_S_SELECT =
		  CHIPA_C & EMS_WINDOW & ACTIVE_MHFA /* for CPU */
		# CHIPA_A & A_SHARE_SELECT           /* for MHF */
		;
	
	B_S_SELECT =
		  CHIPB_C & EMS_WINDOW & ACTIVE_MHFB /* for CPU */
		# CHIPB_A & B_SHARE_SELECT           /* for MHF */
		;
	
	/* }}} */
	/************************************************************/
	/* SHARED READ                                       {{{ OK */
	/************************************************************/
	
	A_S_READ =
		  CHIPA_C & EMS_WINDOW & ACTIVE_MHFA & E & Rw /* for CPU */
		# CHIPA_A & A_READ                            /* for MHF */
		;
	
	B_S_READ =
		  CHIPB_C & EMS_WINDOW & ACTIVE_MHFB & E & Rw /* for CPU */
		# CHIPB_A & B_READ                            /* for MHF */
		;
	
	/* }}} */
	/************************************************************/
	/* SHARED WRITE                                      {{{ OK */
	/************************************************************/
	
	A_S_WRITE =
		  CHIPA_C & EMS_WINDOW & ACTIVE_MHFA & E & !Rw /* for CPU */
		# CHIPA_A & !A_READ                            /* for MHF */
		;
	
	B_S_WRITE =
		  CHIPB_C & EMS_WINDOW & ACTIVE_MHFB & E & !Rw /* for CPU */
		# CHIPB_A & !B_READ                            /* for MHF */
		;
	
	/* }}} */
	/************************************************************/
	/* GATE ADDRESS DIRECTION                                   */
	/************************************************************/
	
	A_G_A_DIR = BA; /* V HALT rezimu MHF-> CPU */
	B_G_A_DIR = BA;
	
	/* }}} */
	/************************************************************/
	/* DATA DIRECTION                                           */
	/************************************************************/
	
	A_G_D_DIR =
		  !BA & CHIPA_C & Rw                   /* mimo EMS je nezajimave protoze gate je zavrena */
		#  BA & A_HALT  & !A_READ              /* in BA A_READ means MHF want read FROM CPU's SysRAM, so Data goes CPU side -> MHF side */
		;
	
	B_G_D_DIR =
		  !BA & CHIPB_C & Rw                   /* mimo EMS je nezajimave protoze gate je zavrena */
		#  BA & !A_HALT & B_HALT & !B_READ     /* in BA B_READ means MHF want read FROM CPU's SysRAM, so Data goes CPU side -> MHF side */
		;
	
	/* }}} */
	/************************************************************/
	/* ENABLE GATES                                             */
	/************************************************************/
	
	A_G_ENABLE = CHIPA_C & EMS_WINDOW & ACTIVE_MHFA & E
		# BA & A_HALT;
	B_G_ENABLE = CHIPB_C & EMS_WINDOW & ACTIVE_MHFB & E
		# BA & !A_HALT & B_HALT;
	
	/* }}} */
	
	
	
