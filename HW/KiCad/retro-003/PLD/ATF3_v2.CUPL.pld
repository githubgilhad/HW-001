	/*
	                  PREFACE: 
	
	 am building GLUE logic for 6039 retrocomputer (called CPU), to connect MHF cards into EMS windows (4kB each, at $8000 and $9000). 
	
	I am using wincupl and atf1504. Here is code for address decoder (ATF1) and EMS manager (ATF2). Comments are part in English and part in Czech language.
	
	On the CPU PCB is SystemRAM(SysRAM 128kB) and EEPROM(ROM up to 32kB), on each MHF_A and MHF_B are 74HC245 gates for Address[0..15] and Data[0..7] busses that guards SharedRam (A/B 128kB).
	
	On boot HW keeps CPU in HALT mode, until the MHF cards start manage it. They may fill SysRAM with system/data at start (while MHF manage system bus, BA active)
	
	and then let CPU boot (and manage system bus, BA inactive ) from the filled values, or from ROM, depending on external switch BootSource.
	
	CPU can map 4k part of (SysRAM,ROM,SharedRAM_A,SharedRAM_B) into EMS1 and/or EMS2 window (which is managed by ATF2).
	
	SharedRAM serve for sending blocks of data between CPU (4 Mhz) and MHF cards (driven each by ATmega2560 at 16 MHz and different style of RAM communication).
	
	HALT is mainly driven by external pullup for possible extending.
	
	DIRTY is really bad name, should be like "the other side cooperated/cooperate just now". Who writes SharedRAM, set it 0 and when the other read/write it, it is set 1 as sign,
	
	that the data was used and can be rewritten next turn. (Typically command like PRINT "XYZ" or info like KEYS_ENTERED="abcd" do not need reply.)
	
	Default ROM size at boot is A100..FFFF, ROM/system may it change and/or map ROM later at will.
	
	CHIPx_C and CHIPx_A ensure, that who got ownership, keeps it, until explicitly release, the other have to wait. (Be it CPU or MHF_x.)
	
	ATF1504 was too small, so ATF1508 with 80 pins was use as single GLUE chip instead
	
	*/
	
	
	
	Name     ATF3_GLUE;
	PartNo   0003;
	Date     2026-07-23;
	Revision 0.2;
	Designer Gilhad;
	Company  None ;
	Assembly None ;
	Location ;
	Device  f1508isptqfp100;
	
	/************************************************************/
	/* INPUTS                                                   */
	/************************************************************/
	
	     
	     
	
	
	Pin   = BootSrc;	/* 1=ROM, 0=RAM */
	
	
	
	/************************************************************/
	/* OUTPUTS                                                  */
	/************************************************************/
	Pin  = RomMapped;
	
	PIN  = !Dev_Sel_7;
	PIN  = !Dev_Sel_6;
	PIN  = !Dev_Sel_5;
	PIN  = !Dev_Sel_4;
	PIN  = !Dev_Sel_3;
	PIN  = !Dev_Sel_2;
	PIN  = !Dev_Sel_1;
	
	PIN  = !Write;
	PIN  = !Read;
	/*
	NOTE to AI about syntax: in "PIN xx = !NAME" the exclamation mark means, that signal is active low (0V) and inactive high (+5V), so
	PIN 6 = !A;
	PIN 8 = !B;
	Pin 9 = !C; // = 3 active low signals 
	C = A & B; // means C is active (=0V) when (and only when) A is active (=0V) AND B is active (=0V) and the compiler translates it to formula PIN 9 = PIN 6 # PIN 8
	It makes easy to works with active low signals (like Chip Enable), where the equation goes stright Chip is Enable = true mean it is enabled ...
	*/
	/*
	Skutecna jmena signalu a cisla pinu, pokud je pred jmenem !, je signal aktivni v LOW:
	*/
	/************************************************************/
	/* I is Input, O is output, H is 3state HiZ         {{{  OK */
	/************************************************************/
	
	/* IOH Data for everything */
	PIN   = D0;
	PIN   = D1;
	PIN   = D2;
	PIN   = D3;
	PIN   = D4;
	PIN   = D5;
	PIN   = D6;
	PIN   = D7;
	
	
	PIN   = Rw;		/* OH CPU Rw, also used in HALT mode by MHF */
	PIN   = !HALT;	/* O CPU HALT */
	
	/* I CA12..15 is connected to CPU.A12..15 */
	PIN   = CA0;
	PIN   = CA1;
	PIN   = CA2;
	PIN   = CA3;
	PIN   = CA4;
	PIN   = CA5;
	PIN   = CA6;
	PIN   = CA7;
	PIN   = CA8;
	PIN   = CA9;
	PIN   = CA10;
	PIN   = CA11;
	PIN   = CA12;
	PIN   = CA13;
	PIN   = CA14;
	PIN   = CA15;
	
	/* PIN 29  = unused */
	
	
	PIN   = !ROM;		/* O CS for ROM */
	PIN   = !RAM;		/* O CS for RAM */
	
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */
	PIN   = B_S_16;		/* IO connected to SharedRAM.A16 and MHF MCU */
	PIN   = !B_HALT;		/* I MHF request 0=HALT active */
	PIN   = B_READ;		/* I MHF request 1=Read, 0=Write */
	PIN   = B_SHARE_DIRTY;	/* O Dirty+Wanted: if(SHARE_GRANTED){WANTS:1=CPU wants SharedRAM}else{DIRTY:1=CPU already got SharedRAM} */
	PIN   = B_SHARE_GRANTED;	/* O MHF owns SharedRAM 1=Active */
	PIN   = B_SHARE_REQUEST;	/* I MHF wants own SharedRAM 1=Active */
	PIN   = !B_S_SELECT;		/* O SharedRAM ~{CS} 0=Active */
	PIN   = !B_S_READ;		/* O SharedRAM ~{OE} 0=Active */
	PIN   = !B_S_WRITE;		/* O SharedRAM ~{WE} 0=Active */
	PIN   = !B_G_ENABLE;		/* O Gate enabled 0=Enabled 1=HiZ */
	PIN   = B_G_A_DIR;		/* O Address dir 1=MHF->CPU 0=CPU->MHF */
	PIN   = B_G_D_DIR;		/* O Data dir 1=MHF->CPU 0=CPU->MHF */
	PIN   = B_SHARE_SELECT;	/* I MHF request 1=manage SharedRAM 0=manage (BA?SystemRAM:nothing) */
	
	PIN   = A_SHARE_SELECT;	/* I MHF request 1=manage SharedRAM 0=manage (BA?SystemRAM:nothing) */
	PIN   = A_G_D_DIR;		/* O Data dir 1=MHF->CPU 0=CPU->MHF */
	PIN   = A_G_A_DIR;		/* O Address dir 1=MHF->CPU 0=CPU->MHF */
	PIN   = !A_G_ENABLE;		/* O Gate enabled 0=Enabled 1=HiZ */
	PIN   = !A_S_WRITE;		/* O SharedRAM ~{WE} 0=Active */
	PIN   = !A_S_READ;		/* O SharedRAM ~{OE} 0=Active */
	PIN   = !A_S_SELECT;		/* O SharedRAM ~{CS} 0=Active */
	PIN   = A_SHARE_REQUEST;	/* I MHF wants own SharedRAM 1=Active */
	PIN   = A_SHARE_GRANTED;	/* O MHF owns SharedRAM 1=Active */
	PIN   = A_SHARE_DIRTY;	/* O Dirty+Wanted: if(SHARE_GRANTED){WANTS:1=CPU wants SharedRAM}else{DIRTY:1=CPU already got SharedRAM} */
	PIN   = A_READ;		/* I MHF request 1=Read, 0=Write */
	PIN   = !A_HALT;		/* I MHF request 0=HALT active */
	PIN   = A_S_16;		/* IO connected to SharedRAM.A16 and MHF MCU */
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */
	/* }}} */
	/* I HD6309 CPU signals {{{ OK */
	PIN   = BS;
	PIN   = MRDY;
	PIN   = DMA_BREQ;
	PIN   = Dev_FIRQ;
	PIN   = Dev_IRQ;
	PIN   = Dev_NMI;
	PIN   = BA;
	/* }}} */
	/* OH GA12..16 is connected to SystemRAM.A12..16 and SysBus.A12..15 {{{ OK */
	PIN  = GA16;
	PIN  = GA15;
	PIN  = GA14;
	PIN  = GA13;
	PIN  = GA12;
	/* }}} */
	/***** Input Only {{{ *** OK */
	
	/***** Input Only ****/
	
	/* Pin 85 = IO_52;      /* INPUT/GCLK3 */ 
	Pin 87 = E;      /* INPUT/GCLK1 */
	Pin 88 = xIO_62; /* INPUT/OE1 - 12V Vpp */
	Pin 89 = !Reset; /* INPUT/GCLR */
	Pin 90 = Q;      /* INPUT/OE2/GCLK2 */
	/* }}} */
	/* {{{ HD6309 Memory Regions OK
	 +-----------------------------------------------------------------------------+
	 |   HD6309 Memory Regions                                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   TYP     hex | RANGE         | CONTENT                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   0000     0  | 0000..FFFF    | HALT / BA 128 kB System RAM for free use    |
	 +---------------+---------------+---------------------------------------------+
	 |   0000     0  | 0000..7FFF    | Native RAM 32K (or more)                    |
	 +---------------+---------------+---------------------------------------------+
	 |   0001     1  | 8000..8FFF    | EMS1 4K                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   0010     2  | 9000..9FFF    | EMS2 4K                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   1rrr     8+ | A000..A005    | 6 GLUE registers ( rrr = regnum )           |
	 +---------------+---------------+---------------------------------------------+
	 |   1000     8  | A000          | RW GLUE register 000 EMS1.Page AAxBBBBB     |
	 +---------------+---------------+---------------------------------------------+
	 |   1001     9  | A001          | R  GLUE register 001 EMS1.Status xxxxxWxC   |
	 +---------------+---------------+---------------------------------------------+
	 |   1010     A  | A002          | RW GLUE register 002 EMS2.Page AAxBBBBB     |
	 +---------------+---------------+---------------------------------------------+
	 |   1011     B  | A003          | R  GLUE register 003 EMS2.Status xxxxxWxC   |
	 +---------------+---------------+---------------------------------------------+
	 |   1100     C  | A004          | R  GLUE register 004 ChipA.Status xxxxDWAC  |
	 +---------------+---------------+---------------------------------------------+
	 |   1101     D  | A005          | R  GLUE register 005 ChipB.Status xxxxDWAC  |
	 +---------------+---------------+---------------------------------------------+
	 |   1111     F  | A006..A007    | RW GLUE ATF1 registers RomMapped + ROM_SIZE |
	 +---------------+---------------+---------------------------------------------+
	 |   1111     F  | A008..A01F    | GLUE registers reserved                     |
	 +---------------+---------------+---------------------------------------------+
	 |   0100     4  | A020..A0FF    | Memory mapped devices [1..7] x 32 B         |
	 +---------------+---------------+---------------------------------------------+
	 |   0011     3  | A100..FFFF    | Native ROM 23.75K (or less)                 |
	 +---------------+---------------+---------------------------------------------+
	}}} */
	/* registers D are read in 0.25 tact !Q (CPU cycle)         */
	/* EMSx_Ax      is set  in 0.25 tact !Q (from D[])          */
	/* EMSx_is_MHFx is set  in 0.25 tact !Q (logic of EMSx_x)   */
	/* CHIPx_C      is set  in 0.5  tact !E (dep: EMSx_is_MHFx) */
	/* CHIPx_A      is set  in 0.75 tact  Q (dep: CHIPx_C)      */
	/* CHIPx_Dx     is set  in 0.0  tact  E (dep: CHIPx_A)      */
	
	
	NODE  = MR3;
	NODE  = MR2;
	NODE  = MR1;
	NODE  = MR0;
	
	
	/************************************************************/
	/* BIDIRECTIONAL  (data)                                    */
	/************************************************************/
	Pin [58,60,61,63, 64,65,67,68] = [D0..7]; 
	/*
	Pin 58  = IO_35;
	Pin 60  = IO_36;
	Pin 61  = IO_37;
	Pin 63  = IO_38;
	Pin 64  = IO_39;
	Pin 65  = IO_40;
	Pin 67  = IO_41;
	Pin 68  = IO_42;
	*/
	
	/************************************************************/
	/* vytazeni vnitrnich vyrazu pro testy                      */
	/************************************************************/
	
	
	/*  {{{ pin numbers
	
	***** PWR, NC, JTAG *****
	
	Pin 1  = NC;
	Pin 2  = NC;
	Pin 3  = VCC;
	Pin 4  = TDI; 
	Pin 5  = NC;
	Pin 7  = NC;
	Pin 11 = GND;
	Pin 15 = TMS;  
	Pin 18 = VCC;
	Pin 22 = NC;
	Pin 24 = NC;
