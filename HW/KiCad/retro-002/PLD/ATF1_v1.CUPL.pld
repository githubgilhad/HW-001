/************************************************************/
/* REG7 ROM_SIZE                                            */
/************************************************************/
NODE [ROM_SIZE2..0];
FIELD ROM_SIZE = [ROM_SIZE2..0];

/* 

4+ = vypnuto
3 = 4k
2 = 8k
1 = 16k
0 = 24.75 kB
*/
/************************************************************/

FIELD CA = [CA15..CA0];

/************************************************************/
/* ADDRESS DECODE                                           */
/************************************************************/

NATIVE_RAM_LO = CA:[0000..7FFF];

EMS1_WINDOW = CA:[8000..8FFF];

EMS2_WINDOW = CA:[9000..9FFF];

/* ATF2 registry */
REG0 = (CA:A000); /* EMS1_PAGE */
REG1 = (CA:A001); /* EMS1_STATUS */
REG2 = (CA:A002); /* EMS2_PAGE */
REG3 = (CA:A003); /* EMS2_STATUS */
REG4 = (CA:A004); /* CHIPA_STATUS */
REG5 = (CA:A005); /* CHIPB_STATUS */

REG_MIRROR = CA:[A006..A01F]; 
/* nasleduji ATF1 registry */
REG6 = (CA:A006); /* ROM_STATUS */
REG7 = (CA:A007); /* ROM_SIZE */

DEVICE_AREA = CA:[A020..A0FF];

ROM_24K = CA:[A100..FFFF];
ROM_16K = CA:[C000..FFFF];
ROM_8K  = CA:[E000..FFFF];
ROM_4K  = CA:[F000..FFFF];


ROM_AREA = 
	  ((ROM_SIZE:0) & ROM_24K)
	# ((ROM_SIZE:1) & ROM_16K)
	# ((ROM_SIZE:2) & ROM_8K)
	# ((ROM_SIZE:3) & ROM_4K)
	/* ROM_SIZE 4+ == zadna ROM */
	;

NATIVE_RAM_HI = ROM_24K & !ROM_AREA;





/************************************************************/
/* MEMORY REGION BUS                                        */
/************************************************************/

MR0 =
      EMS1_WINDOW
    # ROM_AREA
    # REG1
    # REG3
    # REG5
    # REG_MIRROR;

MR1 =
      EMS2_WINDOW
    # ROM_AREA
    # DEVICE_AREA
    # REG2
    # REG3
    # REG_MIRROR;

MR2 =
      DEVICE_AREA
    # REG4
    # REG5
    # REG_MIRROR;

MR3 =
      REG0
    # REG1
    # REG2
    # REG3
    # REG4
    # REG5
    # REG_MIRROR;

/*
	NATIVE_RAM_LO	MR = 0; 	0000
	NATIVE_RAM_HI	MR = 0; 	0000
	EMS1_WINDOW	MR = 1; 	0001
	EMS2_WINDOW	MR = 2; 	0010
	
	REG0		MR = 8; 	1000
	REG1		MR = 9; 	1001
	REG2		MR = 10; 	1010
	REG3		MR = 11; 	1011
	REG4		MR = 12; 	1100
	REG5		MR = 13; 	1101
	
	REG_MIRROR	MR = 15; 	1111
	
	DEVICE_AREA	MR = 4; 	0100
	
	ROM_AREA	MR = 3; 	0011
*/

/************************************************************/
/* READ / WRITE                                             */
/************************************************************/

Read  = E &  Rw;
Write = E & !Rw;

/************************************************************/
/* DEVICE SELECTS                                           */
/************************************************************/

/*
 * EMS windows:
 *   ATF1 releases DEV0
 *   ATF2 drives DEV0
 */

RAM 		= NATIVE_RAM_LO 
		# NATIVE_RAM_HI 
		# ROM_AREA & !RomMapped;

ROM		= ROM_AREA &  RomMapped;

EMS_WINDOW 	= EMS1_WINDOW # EMS2_WINDOW;

RAM.OE	= !EMS_WINDOW; /* managed by ATF2 */
ROM.OE	= !EMS_WINDOW; /* managed by ATF2 */

/************************************************************/
/* DEVICE BLOCK                                             */
/************************************************************/

Dev_Sel_1 = CA:[A020..A03F];
Dev_Sel_2 = CA:[A040..A05F];
Dev_Sel_3 = CA:[A060..A07F];
Dev_Sel_4 = CA:[A080..A09F];
Dev_Sel_5 = CA:[A0A0..A0BF];
Dev_Sel_6 = CA:[A0C0..A0DF];
Dev_Sel_7 = CA:[A0E0..A0FF];


/************************************************************/
/* ATF1 Registers Write                                     */
/************************************************************/

/************************************************************/
/* REG6 ROM_STATUS                                          */
/************************************************************/

/* RomMapped se pri resetu nastavi na BootSrc,
	pri zapisu zmeni hodnotu na zapsanou */
/*
RomMapped.d =
       Reset & BootSrc
    # !Reset & D0;

RomMapped.CK = E;
RomMapped.CE =    Reset 
		# REG6 & !Rw;

*/

RomMapped.d = D0;

RomMapped.CK = !Q;
RomMapped.AR = Reset & !BootSrc;
RomMapped.AP = Reset & BootSrc;
RomMapped.CE = REG6 & !Rw;


/************************************************************/
/* REG7 ROM_SIZE                                            */
/************************************************************/

ROM_SIZE.d=[D2..D0];

ROM_SIZE.CK=!Q;
ROM_SIZE.AR=Reset;
ROM_SIZE.CE = REG7 & !Rw;


/************************************************************/
/* ATF1 Registers Read                                      */
/************************************************************/

[D7..D0].OE = E & Rw & ( REG6 # REG7 ); /* write full D */

[D7..D3] = E & !E;		/* 0 for unused */

[D2]  = REG7 & ROM_SIZE2
	# REG6 & !REG6; 		/* 0 for REG6 */

[D1]  = REG7 & ROM_SIZE1
	# REG6 & BootSrc;

[D0]  = REG7 & ROM_SIZE0
	# REG6 & RomMapped;

