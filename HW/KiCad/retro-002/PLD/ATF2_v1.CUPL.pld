	Name     ATF2_GLUE;
	PartNo   0002;
	Date     2026-06-26;
	Revision 0.1;
	Designer Gilhad and ChatGPT;
	Company  None ;
	Assembly None ;
	Location ;
	Device  f1504isptqfp100;
	
	/*
	Skutecna jmena signalu a cisla pinu, pokud je pred jmenem !, je signal aktivni v LOW:
	*/
	/************************************************************/
	/* I is Input, O is output, H is 3state HiZ         {{{  OK */
	/************************************************************/
	
	/* IOH Data for everything */
	PIN 6   = D0;
	PIN 8   = D1;
	PIN 9   = D2;
	PIN 10  = D3;
	PIN 12  = D4;
	PIN 13  = D5;
	PIN 14  = D6;
	PIN 16  = D7;
	
	
	PIN 17  = Rw;		/* OH CPU Rw, also used in HALT mode by MHF */
	PIN 19  = !HALT;	/* O CPU HALT */
	
	/* I CA12..15 is connected to CPU.A12..15 */
	PIN 20  = CA12;
	PIN 21  = CA13;
	PIN 23  = CA14;
	PIN 25  = CA15;
	
	/* PIN 29  = unused */
	
	
	PIN 30  = !ROM;		/* O CS for ROM */
	PIN 31  = !RAM;		/* O CS for RAM */
	
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */
	PIN 32  = B_S_16;		/* IO connected to SharedRAM.A16 and MHF MCU */
	PIN 33  = !B_HALT;		/* I MHF request 0=HALT active */
	PIN 35  = B_READ;		/* I MHF request 1=Read, 0=Write */
	PIN 36  = B_SHARE_DIRTY;	/* O Dirty+Wanted: if(SHARE_GRANTED){WANTS:1=CPU wants SharedRAM}else{DIRTY:1=CPU already got SharedRAM} */
	PIN 37  = B_SHARE_GRANTED;	/* O MHF owns SharedRAM 1=Active */
	PIN 40  = B_SHARE_REQUEST;	/* I MHF wants own SharedRAM 1=Active */
	PIN 41  = !B_S_SELECT;		/* O SharedRAM ~{CS} 0=Active */
	PIN 42  = !B_S_READ;		/* O SharedRAM ~{OE} 0=Active */
	PIN 44  = !B_S_WRITE;		/* O SharedRAM ~{WE} 0=Active */
	PIN 45  = !B_G_ENABLE;		/* O Gate enabled 0=Enabled 1=HiZ */
	PIN 46  = B_G_A_DIR;		/* O Address dir 1=MHF->CPU 0=CPU->MHF */
	PIN 47  = B_G_D_DIR;		/* O Data dir 1=MHF->CPU 0=CPU->MHF */
	PIN 48  = B_SHARE_SELECT;	/* I MHF request 1=manage SharedRAM 0=manage (BA?SystemRAM:nothing) */
	
	PIN 52  = A_SHARE_SELECT;	/* I MHF request 1=manage SharedRAM 0=manage (BA?SystemRAM:nothing) */
	PIN 54  = A_G_D_DIR;		/* O Data dir 1=MHF->CPU 0=CPU->MHF */
	PIN 56  = A_G_A_DIR;		/* O Address dir 1=MHF->CPU 0=CPU->MHF */
	PIN 57  = !A_G_ENABLE;		/* O Gate enabled 0=Enabled 1=HiZ */
	PIN 58  = !A_S_WRITE;		/* O SharedRAM ~{WE} 0=Active */
	PIN 60  = !A_S_READ;		/* O SharedRAM ~{OE} 0=Active */
	PIN 61  = !A_S_SELECT;		/* O SharedRAM ~{CS} 0=Active */
	PIN 63  = A_SHARE_REQUEST;	/* I MHF wants own SharedRAM 1=Active */
	PIN 64  = A_SHARE_GRANTED;	/* O MHF owns SharedRAM 1=Active */
	PIN 65  = A_SHARE_DIRTY;	/* O Dirty+Wanted: if(SHARE_GRANTED){WANTS:1=CPU wants SharedRAM}else{DIRTY:1=CPU already got SharedRAM} */
	PIN 67  = A_READ;		/* I MHF request 1=Read, 0=Write */
	PIN 68  = !A_HALT;		/* I MHF request 0=HALT active */
	PIN 69  = A_S_16;		/* IO connected to SharedRAM.A16 and MHF MCU */
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */
	/* }}} */
	/* I HD6309 CPU signals {{{ OK */
	PIN 71  = BS;
	PIN 75  = MRDY;
	PIN 76  = DMA_BREQ;
	PIN 79  = Dev_FIRQ;
	PIN 80  = Dev_IRQ;
	PIN 81  = Dev_NMI;
	PIN 83  = BA;
	/* }}} */
	/* I Memory Regions {{{ OK */
	PIN 84  = MR3;
	PIN 92  = MR2;
	PIN 93  = MR1;
	PIN 94  = MR0;
	/* }}} */
	/* OH GA12..16 is connected to SystemRAM.A12..16 and SysBus.A12..15 {{{ OK */
	PIN 96  = GA16;
	PIN 97  = GA15;
	PIN 98  = GA14;
	PIN 99  = GA13;
	PIN 100 = GA12;
	/* }}} */
	/***** Input Only {{{ *** OK */
	
	/* Pin 85 = IO_52;      /* INPUT/GCLK3 */ 
	Pin 87 = E;      /* INPUT/GCLK1 */
	Pin 88 = xIO_62; /* INPUT/OE1 - 12V Vpp */
	Pin 89 = !Reset; /* INPUT/GCLR */
	Pin 90 = Q;      /* INPUT/OE2/GCLK2 */
	/* }}} */
	/* {{{ HD6309 Memory Regions OK
	 +-----------------------------------------------------------------------------+
	 |   HD6309 Memory Regions                                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   TYP     hex | RANGE         | CONTENT                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   0000     0  | 0000..7FFF    | Native RAM 32K (or more)                    |
	 +---------------+---------------+---------------------------------------------+
	 |   0001     1  | 8000..8FFF    | EMS1 4K                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   0010     2  | 9000..9FFF    | EMS2 4K                                     |
	 +---------------+---------------+---------------------------------------------+
	 |   1rrr     8+ | A000..A005    | 6 GLUE registers ( rrr = regnum )           |
	 +---------------+---------------+---------------------------------------------+
	 |   1000     8  | A000          | RW GLUE register 000 EMS1.Page AAxBBBBB     |
	 +---------------+---------------+---------------------------------------------+
	 |   1001     9  | A001          | R  GLUE register 001 EMS1.Status xxxxxWxC   |
	 +---------------+---------------+---------------------------------------------+
	 |   1010     A  | A002          | RW GLUE register 002 EMS2.Page AAxBBBBB     |
	 +---------------+---------------+---------------------------------------------+
	 |   1011     B  | A003          | R  GLUE register 003 EMS2.Status xxxxxWxC   |
	 +---------------+---------------+---------------------------------------------+
	 |   1100     C  | A004          | R  GLUE register 004 ChipA.Status xxxxDWAC  |
	 +---------------+---------------+---------------------------------------------+
	 |   1101     D  | A005          | R  GLUE register 005 ChipB.Status xxxxDWAC  |
	 +---------------+---------------+---------------------------------------------+
	 |   1111     F  | A006..A007    | RW GLUE ATF1 registers RomMapped + ROM_SIZE |
	 +---------------+---------------+---------------------------------------------+
	 |   1111     F  | A008..A01F    | GLUE registers reserved                     |
	 +---------------+---------------+---------------------------------------------+
	 |   0100     4  | A020..A0FF    | Memory mapped devices [1..7] x 32 B         |
	 +---------------+---------------+---------------------------------------------+
	 |   0011     3  | A100..FFFF    | Native ROM 23.75K (or less)                 |
	 +---------------+---------------+---------------------------------------------+
	}}} */
	/************************************************************/
	/* SOME DECLARATION - need to check {{{                     */
	/************************************************************/
	
	
	TRUE = E # !E;
	FALSE = E & !E;
	
	/************************************************************/
	/* FIELDS                                                   */
	/************************************************************/
	
	FIELD MR = [MR3..MR0];
	
	FIELD EMS1_PAGE = [EMS1_A1, EMS1_A0, EMS1_B4, EMS1_B3, EMS1_B2, EMS1_B1, EMS1_B0];
	FIELD EMS2_PAGE = [EMS2_A1, EMS2_A0, EMS2_B4, EMS2_B3, EMS2_B2, EMS2_B1, EMS2_B0];
	
	/* data from CPU */
	FIELD DATA = [D7..D0];
	
	
	/************************************************************/
	/* INTERNAL NODES                                           */
	/************************************************************/
	
	/* EMS1 mapping */
	
	NODE EMS1_A1;
	NODE EMS1_A0;
	
	NODE EMS1_B4;
	NODE EMS1_B3;
	NODE EMS1_B2;
	NODE EMS1_B1;
	NODE EMS1_B0;
	
	/* EMS2 mapping */
	
	NODE EMS2_A1;
	NODE EMS2_A0;
	
	NODE EMS2_B4;
	NODE EMS2_B3;
	NODE EMS2_B2;
	NODE EMS2_B1;
	NODE EMS2_B0;
	
	
	/************************************************************/
	/* Chip ownership/state                                     */
	/************************************************************/
	
	/*
	A = owned by MHF
	C = owned by CPU
	Dc, Dm = dirty (from viewpoint of CPU or MHF)
	*/
	
	NODE CHIPA_A;
	NODE CHIPA_C;
	NODE CHIPA_Dc;
	NODE CHIPA_Dm;
	
	NODE CHIPB_A;
	NODE CHIPB_C;
	NODE CHIPB_Dc;
	NODE CHIPB_Dm;
	
	
	/************************************************************/
	/* Derived signals                                          */
	/************************************************************/
	
	NODE EMS1_is_SYS;
	NODE EMS1_is_MHFA;
	NODE EMS1_is_MHFB;
	NODE EMS1_is_ROM;
	
	NODE EMS2_is_SYS;
	NODE EMS2_is_MHFA;
	NODE EMS2_is_MHFB;
	NODE EMS2_is_ROM;
	
	
	NODE CHIPA_W;
	NODE CHIPB_W;
	
	NODE CPU_WANTS_A;
	NODE CPU_WANTS_B;
	
	NODE CPU_USES_A;
	NODE CPU_USES_B;
	
	NODE HALT_MODE;
	
	NODE REG_ACCESS;
	NODE REG_READ;
	NODE REG_WRITE;
	
	NODE EMS_WINDOW;
	NODE ROM_WINDOW;
	NODE RAM_WINDOW;
	
	NODE ACTIVE_PAGE_A1;
	NODE ACTIVE_PAGE_A0;
	
	NODE ACTIVE_B4;
	NODE ACTIVE_B3;
	NODE ACTIVE_B2;
	NODE ACTIVE_B1;
	NODE ACTIVE_B0;
	
	/* }}} */
	/************************************************************/
	/* CONSTANT DECODE - need to check {{{                      */
	/************************************************************/
	
	RAM_WINDOW =
	       (MR:0);
	
	EMS_WINDOW =
	       (MR:1)
	    #  (MR:2);
	
	ROM_WINDOW =
	       (MR:3);
	
	/* MR:8 .. MR:D - registers */
	REG_ACCESS = 
		   (MR:[8..D])
		 & E 
		 & !BA;
	REG_READ = 
		REG_ACCESS 
		& Rw ; 
	REG_WRITE = 
		REG_ACCESS 
		& !Rw ;
	/*
	REG_READ  = E & !BA &  Rw & (MR:[8..D]);
	REG_WRITE = E & !BA & !Rw & (MR:[8..D]);
	*/
	
	HALT_MODE =
	      !HALT
	    & BA;
	
	CPU_MODE  = !HALT_MODE;
	BUS_MODE  = HALT_MODE;
	
	/************************************************************/
	/* Decode current mapping                                   */
	/************************************************************/
	
	EMS1_is_SYS  = !EMS1_A1 & !EMS1_A0;
	EMS1_is_MHFA = !EMS1_A1 &  EMS1_A0;
	EMS1_is_MHFB =  EMS1_A1 & !EMS1_A0;
	EMS1_is_ROM  =  EMS1_A1 &  EMS1_A0;
	
	EMS2_is_SYS  = !EMS2_A1 & !EMS2_A0;
	EMS2_is_MHFA = !EMS2_A1 &  EMS2_A0;
	EMS2_is_MHFB =  EMS2_A1 & !EMS2_A0;
	EMS2_is_ROM  =  EMS2_A1 &  EMS2_A0;
	
	
	/* }}} */
	/************************************************************/
	/* REG0 EMS1 PAGE {{{   (A[1..0] x B[4..0])              OK */
	/************************************************************/
	/*
	D7 D6 = AA
	D5 = reserved
	D4..D0 = BBBBB
	*/
	
	EMS1_A1.D = D7;
	EMS1_A0.D = D6;
	
	EMS1_B4.D = D4;
	EMS1_B3.D = D3;
	EMS1_B2.D = D2;
	EMS1_B1.D = D1;
	EMS1_B0.D = D0;
	/*
	AA:
	
	00 System RAM
	01 MHF_A
	10 MHF_B
	11 invalid/ROM TODO
	*/
	
	
	/* spolecne rizeni 0.25 tact */
	
	EMS1_A1.CK = !Q;
	EMS1_A0.CK = !Q;
	
	EMS1_B4.CK = !Q;
	EMS1_B3.CK = !Q;
	EMS1_B2.CK = !Q;
	EMS1_B1.CK = !Q;
	EMS1_B0.CK = !Q;
	
	EMS1_A1.AR = Reset;
	EMS1_A0.AR = Reset;
	
	/* EMS1_B4.AR = Reset;	 default $8000 */
	EMS1_B4.AR = Reset;
	EMS1_B3.AP = Reset;
	EMS1_B2.AR = Reset;
	EMS1_B1.AR = Reset;
	EMS1_B0.AR = Reset;
	
	EMS1_A1.CE = REG_WRITE & (MR:8);
	EMS1_A0.CE = REG_WRITE & (MR:8);
	
	EMS1_B4.CE = REG_WRITE & (MR:8);
	EMS1_B3.CE = REG_WRITE & (MR:8);
	EMS1_B2.CE = REG_WRITE & (MR:8);
	EMS1_B1.CE = REG_WRITE & (MR:8);
	EMS1_B0.CE = REG_WRITE & (MR:8);
	
	/* }}} */
	/************************************************************/
	/* REG2 EMS2 PAGE {{{ (A[1..0] x B[4..0])               OK  */
	/************************************************************/
	
	/*
	D7 D6 = AA
	D5 = reserved
	D4..D0 = BBBBB
	*/
	
	EMS2_A1.D = D7;
	EMS2_A0.D = D6;
	
	EMS2_B4.D = D4;
	EMS2_B3.D = D3;
	EMS2_B2.D = D2;
	EMS2_B1.D = D1;
	EMS2_B0.D = D0;
	/*
	AA:
	
	00 System RAM
	01 MHF_A
	10 MHF_B
	11 invalid/ROM TODO
	*/
	
	EMS2_A1.CK = !Q;
	EMS2_A0.CK = !Q;
	
	EMS2_B4.CK = !Q;
	EMS2_B3.CK = !Q;
	EMS2_B2.CK = !Q;
	EMS2_B1.CK = !Q;
	EMS2_B0.CK = !Q;
	
	EMS2_A1.AR = Reset;
	EMS2_A0.AR = Reset;
	
	EMS2_B4.AR = Reset;	/* default $9000 */
	EMS2_B3.AP = Reset;
	EMS2_B2.AR = Reset;
	EMS2_B1.AR = Reset;
	EMS2_B0.AP = Reset;
	
	EMS2_A1.CE = REG_WRITE & (MR:A);
	EMS2_A0.CE = REG_WRITE & (MR:A);
	
	EMS2_B4.CE = REG_WRITE & (MR:A);
	EMS2_B3.CE = REG_WRITE & (MR:A);
	EMS2_B2.CE = REG_WRITE & (MR:A);
	EMS2_B1.CE = REG_WRITE & (MR:A);
	EMS2_B0.CE = REG_WRITE & (MR:A);
	
	
	/* }}} */
	/* SUPERVISED part BEGIN {{{ */
	/************************************************************/
	/* HALT mode                                                */
	/************************************************************/
	
	HALT =	   A_HALT # B_HALT;
	HALT.OE =  A_HALT # B_HALT; /* enabled if driven by us */
	
	/* nasledne se aktivuje BA behem nekolika taktu a tim se odpoji sbernice od CPU */
	
	/* Rw je bezne ovladan ATF1, s vyjimkou HALT rezimu, kdy to prevezme ATF2 a ridi se dle MHF_x */
	Rw =	  !A_S_READ & A_HALT
		# !B_S_READ & B_HALT & !A_HALT; /* directed by A primary, or B secondary */
	Rw.OE =	  BA; /* driven only in HALT mode */
	
	/* RAM je bezne ovladan ATF1, s vyjimkou HALT rezimu a EMS oken, kdy to prevezme ATF2 a ridi se dle MHF_x a nastaveni EMS  */
	RAM =	  BA                /* v HALT rezimu je RAM vybrana permanentne */
		# (MR:1) & EMS1_is_SYS /* Sys RAM selected in EMS1 */
		# (MR:2) & EMS2_is_SYS /* Sys RAM selected in EMS2 */
		;
	RAM.OE =   BA
		# (MR:1)
		# (MR:2)
		;
	
	/* ROM je  bezne ovladan ATF1, s vyjimkou HALT rezimu (kde vybran neni) a EMS oken, kdy to prevezme ATF2 a ridi se dle MHF_x a nastaveni EMS  */
	ROM = 	
		  (MR:1) & EMS1_is_ROM & !BA
		# (MR:2) & EMS2_is_ROM & !BA
		;
	ROM.OE =   BA
		# (MR:1)
		# (MR:2)
		;
	
	/*  IO connected to SharedRAM.A16 and MHF MCU */
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */ /* TODO GA16 */
	A_S_16 = 	  (MR:1) & EMS1_is_MHFA & CHIPA_C & EMS1_B4
			# (MR:2) & EMS2_is_MHFA & CHIPA_C & EMS2_B4
			;
	A_S_16.OE = 	  (MR:1) & EMS1_is_MHFA & CHIPA_C 
			# (MR:2) & EMS2_is_MHFA & CHIPA_C 
			;
	
	/*  IO connected to SharedRAM.A16 and MHF MCU */
			/* pokud CPU vlastni shared RAM, je to Output a ovlada jeji A16 */
			/* pokud je HALT a BA a MHF vybral SystemRAM, je to input a ovlada GA16 */ /* TODO GA16 */
	B_S_16 = 	  (MR:1) & EMS1_is_MHFB & CHIPB_C & EMS1_B4
			# (MR:2) & EMS2_is_MHFB & CHIPB_C & EMS2_B4
			;
	B_S_16.OE = 	  (MR:1) & EMS1_is_MHFB & CHIPB_C 
			# (MR:2) & EMS2_is_MHFB & CHIPB_C 
			;
	/* O Dirty+Wanted+BA: BA?1:if(SHARE_GRANTED){WANTS:1=CPU wants SharedRAM}else{DIRTY:1=CPU already got SharedRAM} */
	/* in HALT state 1= writing SystemRAM is possible
	 * if SHARE_GRANTED 1= CPU already wants SharedRAM (=please release it soon)
	 * if !SHARE_GRANTED 1 = CPU already got SharedRAM (=and maybe modified it)
	 * 0 = nothing special
	 */
	A_SHARE_DIRTY =	  BA
			# A_SHARE_GRANTED & ( EMS1_is_MHFA # EMS2_is_MHFA )
			# !A_SHARE_GRANTED & CHIPA_Dm
			;
	B_SHARE_DIRTY =	  BA & !A_HALT /* write if MHF_A released it alredy */
			# B_SHARE_GRANTED & ( EMS1_is_MHFB # EMS2_is_MHFB )
			# !B_SHARE_GRANTED & CHIPB_Dm
			;
	A_SHARE_GRANTED =	A_SHARE_REQUEST & CHIPA_A;
	B_SHARE_GRANTED =	B_SHARE_REQUEST & CHIPB_A;
	
	/************************************************************/
	/* OWNERSHIP CHIP_xx                   {{{               OK */
	/************************************************************/
	/* EMSx_is_MHFx is re/set in 0.25 tact */
	CHIPA_C.d =
			  EMS1_is_MHFA & !CHIPA_A
			# EMS2_is_MHFA & !CHIPA_A /* set if ask and free */
			# EMS1_is_MHFA &  CHIPA_C
			# EMS2_is_MHFA &  CHIPA_C /* keep if ask */
			;
	CHIPB_C.d =
			  EMS1_is_MHFB & !CHIPB_A
			# EMS2_is_MHFB & !CHIPB_A /* set if ask and free */
			# EMS1_is_MHFB &  CHIPB_C
			# EMS2_is_MHFB &  CHIPB_C /* keep if ask */
			;
	
	CHIPA_C.CK = !E; /* 0.5 tact */
	CHIPB_C.CK = !E; /* 0.5 tact */
	
	CHIPA_A.d =
			  A_SHARE_REQUEST & !CHIPA_C /* set */
			# A_SHARE_REQUEST &  CHIPA_A /* keep */
			;
	CHIPB_A.d =
			  B_SHARE_REQUEST & !CHIPB_C
			# B_SHARE_REQUEST &  CHIPB_A
			;
	CHIPA_A.CK = Q; /* 0.75 tact */
	CHIPB_A.CK = Q; /* 0.75 tact */
	
	
	CHIPA_Dc.d = 
			  CHIPA_A
			# CHIPA_Dc & !CHIPA_C;
	CHIPA_Dc.CK = E; /* 0.0 tact, az po CHIPA_A a CHIPA_C, a pred zapisem registru, na pocatku cteni, takze CPU uz cte pripadne novou hodnotu  */ 
	
	CHIPA_Dm.d = 
			  CHIPA_C
			# CHIPA_Dm & !CHIPA_A;
	CHIPA_Dm.CK = E; /* 0.0 tact, az po CHIPA_A a CHIPA_C, a pred zapisem registru, na pocatku cteni, takze CPU uz cte pripadne novou hodnotu  */ 
	
	/* }}} */
	/************************************************************/
	/* REGISTERS READ  {{{                                OK    */
	/************************************************************/
	/* REG0 */
	
	[D7..D0].OE = REG_READ;
	
	D7 =  REG_READ & (
		  (MR:8)  & EMS1_A1
		# (MR:A) & EMS2_A1
		);
	
	D6 =  REG_READ & (
		  (MR:8)  & EMS1_A0
		# (MR:A) & EMS2_A0
		);
	
	D5 =  REG_READ & (
		/*  (MR:8) & FALSE ) */
		FALSE
		);
	
	D4 =  REG_READ & (
		  (MR:8)  & EMS1_B4
		# (MR:A) & EMS2_B4
		);
	D3 =  REG_READ & (
		  (MR:8)  & EMS1_B3
		# (MR:A) & EMS2_B3
		# (MR:C) & CHIPA_Dc
		# (MR:D) & CHIPB_Dc
		);
	D2 =  REG_READ & (
		  (MR:8) & EMS1_B2
		# (MR:9) & EMS1_W
		# (MR:A) & EMS2_B2
		# (MR:B) & EMS2_W
		# (MR:C) & CHIPA_W
		# (MR:D) & CHIPB_W
		);
	D1 =  REG_READ & (
		  (MR:8) & EMS1_B1
		# (MR:A) & EMS2_B1
		# (MR:C) & CHIPA_A
		# (MR:D) & CHIPB_A
		);
	D0 =  REG_READ & (
		  (MR:8) & EMS1_B0
		# (MR:9) & EMS1_C
		# (MR:A) & EMS2_B0
		# (MR:B) & EMS2_C
		# (MR:C) & CHIPA_C
		# (MR:D) & CHIPB_C
		);
	/* }}} */
	/************************************************************/
	/* SUPERVISED part ENDS }}}                                 */
	/************************************************************/


	/************************************************************/
	/* EMS STATUS                                        OK {{{ */
	/************************************************************/
	
	EMS1_C = /* owned by CPU */
		  EMS1_is_SYS
		# EMS1_is_MHFA & CHIPA_C
		# EMS1_is_MHFB & CHIPB_C
		# EMS1_is_ROM
		;
	
	
	EMS2_C =
		  EMS2_is_SYS
		# EMS2_is_MHFA & CHIPA_C
		# EMS2_is_MHFB & CHIPB_C
		# EMS2_is_ROM
		;
	
	EMS1_W = /* Wanted by card */
		  EMS1_is_MHFA & A_SHARE_REQUEST
		# EMS1_is_MHFB & B_SHARE_REQUEST
		;
	
	EMS2_W = /* Wanted by card */
		  EMS2_is_MHFA & A_SHARE_REQUEST
		# EMS2_is_MHFB & B_SHARE_REQUEST
		;
	/* }}} */
	/************************************************************/
	/* MHF wants which chip                              OK {{{ */
	/************************************************************/
	
	CHIPA_W = A_SHARE_REQUEST;
	CHIPB_W = B_SHARE_REQUEST;
	
	/* }}} */
	/************************************************************/
	/* CPU / MHF requests                                OK {{{ */
	/************************************************************/
	
	CPU_REQ_A = 
	      EMS1_is_MHFA
	   #  EMS2_is_MHFA;
	CPU_REQ_B = 
	      EMS1_is_MHFB
	   #  EMS2_is_MHFB;
	
	
	MHF_REQ_A = A_SHARE_REQUEST;
	MHF_REQ_B = B_SHARE_REQUEST;
	
	/* }}} */
	/************************************************************/
	/* CHIP A ownership                                    {{{  */
	/************************************************************/
	
	/*
	Pravidla:
	
	00 -> nikdo
	
	10 -> CPU
	
	01 -> MHF
	
	11 -> zakazany stav
	
	Pokud chteji oba:
	
	- vlastnik zustava
	- pokud nebyl zadny -> CPU
	*/
	
	
	CHIPA_C.D =
	
	      ( CPU_REQ_A & !MHF_REQ_A )
	
	   #  ( CPU_REQ_A &  MHF_REQ_A & CHIPA_C )
	
	   #  ( CPU_REQ_A &  MHF_REQ_A & !CHIPA_C & !CHIPA_A );
	
	
	
	CHIPA_A.D =
	
	      ( MHF_REQ_A & !CPU_REQ_A )
	
	   #  ( CPU_REQ_A &  MHF_REQ_A & CHIPA_A );
	
	
	CHIPA_C.CK = !Q;
	CHIPA_C.AR = Reset;
	CHIPA_C.CE = E # !E;
	
	CHIPA_A.CK = !Q;
	CHIPA_A.AR = Reset;
	CHIPA_A.CE = E # !E;
	
	/* }}} */
	/************************************************************/
	/* CHIP B ownership                                    {{{  */
	/************************************************************/
	
	CHIPB_C.D =
	
	      ( CPU_REQ_B & !MHF_REQ_B )
	
	   #  ( CPU_REQ_B &  MHF_REQ_B & CHIPB_C )
	
	   #  ( CPU_REQ_B &  MHF_REQ_B & !CHIPB_C & !CHIPB_A );
	
	
	
	CHIPB_A.D =
	
	      ( MHF_REQ_B & !CPU_REQ_B )
	
	   #  ( CPU_REQ_B &  MHF_REQ_B & CHIPB_A );
	
	
	
	CHIPB_C.CK = !Q;
	CHIPB_C.AR = Reset;
	CHIPB_C.CE = E # !E;
	
	CHIPB_A.CK = !Q;
	CHIPB_A.AR = Reset;
	CHIPB_A.CE = E # !E;
	
	/* SHARE_GRANTED */
	
	A_SHARE_GRANTED = CHIPA_A;
	B_SHARE_GRANTED = CHIPB_A;
	
	/* Dirty A */
	
	CHIPA_D.D = CHIPA_A.D;
	
	CHIPA_D.CK = !Q;
	CHIPA_D.AR = Reset;
	
	CHIPA_D.CE =
	      (CHIPA_A.D $ CHIPA_A)
	   #  (CHIPA_C.D $ CHIPA_C);
	
	
	/* Dirty B */
	
	
	CHIPB_D.D = CHIPB_A.D;
	
	CHIPB_D.CK = !Q;
	CHIPB_D.AR = Reset;
	
	CHIPB_D.CE =
	      (CHIPB_A.D $ CHIPB_A)
	   #  (CHIPB_C.D $ CHIPB_C);
	
	
	
	/* }}} */
	/************************************************************/
	/* SHARE_DIRTY                                              */
	/************************************************************/
	
	A_SHARE_DIRTY =
	
	      !CHIPA_A & CHIPA_D
	
	   #   CHIPA_A & CPU_REQ_A;
	
	
	
	B_SHARE_DIRTY =
	
	      !CHIPB_A & CHIPB_D
	
	   #   CHIPB_A & CPU_REQ_B;
	
	
	/* ############################################################# */
	
	ACTIVE_PAGE_A1 =
	
	      (MR:1 & EMS1_A1)
	
	   #  (MR:2 & EMS2_A1);
	
	
	ACTIVE_PAGE_A0 =
	
	      (MR:1 & EMS1_A0)
	
	   #  (MR:2 & EMS2_A0);
	
	
	ACTIVE_B4 =
	
	      (MR:1 & EMS1_B4)
	
	   #  (MR:2 & EMS2_B4);
	
	ACTIVE_B3 =
	
	      (MR:1 & EMS1_B3)
	
	   #  (MR:2 & EMS2_B3);
	
	ACTIVE_B2 =
	
	      (MR:1 & EMS1_B2)
	
	   #  (MR:2 & EMS2_B2);
	
	ACTIVE_B1 =
	
	      (MR:1 & EMS1_B1)
	
	   #  (MR:2 & EMS2_B1);
	
	ACTIVE_B0 =
	
	      (MR:1 & EMS1_B0)
	
	   #  (MR:2 & EMS2_B0);
	
	
	/* Vyhodnoceni typu stranky */
	/************************************************************/
	/* ACTIVE SOURCE                                            */
	/************************************************************/
	ACTIVE_SYS  = !ACTIVE_PAGE_A1 & !ACTIVE_PAGE_A0;
	ACTIVE_MHFA = !ACTIVE_PAGE_A1 &  ACTIVE_PAGE_A0;
	ACTIVE_MHFB =  ACTIVE_PAGE_A1 & !ACTIVE_PAGE_A0;
	
	ACTIVE_VALID = !(ACTIVE_PAGE_A1 & ACTIVE_PAGE_A0);
	
	
	
	/*                    #branch    */
	
	/* EMS valid */
	
	/* Tohle uz mas skoro hotove. */
	
	EMS_OK =
	
	      ACTIVE_SYS
	
	   # (ACTIVE_MHFA & CHIPA_C)
	
	   # (ACTIVE_MHFB & CHIPB_C);
	
	
	
	
	
	
	
	/*                    #end branch    */
	
	/************************************************************/
	/* EMS ACCESS                                               */
	/************************************************************/
	
	EMS_ACCESS =
	
	      ACTIVE_SYS
	
	   # (ACTIVE_MHFA & CHIPA_C)
	
	   # (ACTIVE_MHFB & CHIPB_C);
	
	/************************************************************/
	/* EMS ADDRESS                                              */
	/************************************************************/
	
	GA16 = ACTIVE_B4;
	GA15 = ACTIVE_B3;
	GA14 = ACTIVE_B2;
	GA13 = ACTIVE_B1;
	GA12 = ACTIVE_B0;
	
	
	/* pouze pri EMS */
	
	GA16.OE = EMS_WINDOW;
	GA15.OE = EMS_WINDOW;
	GA14.OE = EMS_WINDOW;
	GA13.OE = EMS_WINDOW;
	GA12.OE = EMS_WINDOW;
	
	/************************************************************/
	/* SYSTEM RAM SELECT                                        */
	/************************************************************/
	
	RAM =
	      EMS_WINDOW
	   &  ACTIVE_SYS
	   # BA
	   ;
	
	
	RAM.OE = EMS_WINDOW & !BA # BA;
	
	/************************************************************/
	/* SHARED CHIP SELECT                                       */
	/************************************************************/
	
	A_S_SELECT =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFA
	
	   &  CHIPA_C;
	
	
	B_S_SELECT =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFB
	
	   &  CHIPB_C;
	
	/************************************************************/
	/* SHARED READ                                              */
	/************************************************************/
	
	A_S_READ =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFA
	
	   &  CHIPA_C
	
	   &  E
	
	   &  Rw;
	
	
	B_S_READ =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFB
	
	   &  CHIPB_C
	
	   &  E
	
	   &  Rw;
	
	/************************************************************/
	/* SHARED WRITE                                             */
	/************************************************************/
	
	A_S_WRITE =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFA
	
	   &  CHIPA_C
	
	   &  E
	
	   & !Rw;
	
	
	B_S_WRITE =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFB
	
	   &  CHIPB_C
	
	   &  E
	
	   & !Rw;
	
	/************************************************************/
	/* GATE ADDRESS DIRECTION                                   */
	/************************************************************/
	
	A_G_A_DIR = FALSE; /* FIXME Pokud bezi CPU. V HALT rezimu se prepne. */
	B_G_A_DIR = FALSE;
	
	/************************************************************/
	/* DATA DIRECTION                                           */
	/************************************************************/
	
	A_G_D_DIR =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFA
	
	   &  CHIPA_C
	
	   &  Rw;
	
	
	B_G_D_DIR =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFB
	
	   &  CHIPB_C
	
	   &  Rw;
	
	/************************************************************/
	/* ENABLE GATES                                             */
	/************************************************************/
	
	A_G_ENABLE =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFA
	
	   &  CHIPA_C
	
	   &  E;
	
	
	B_G_ENABLE =
	
	      EMS_WINDOW
	
	   &  ACTIVE_MHFB
	
	   &  CHIPB_C
	
	   &  E;
	
	
	
	
	
	
	/*
	Jedna optimalizace, kterou bych udelal
	
	V navrhu mas nekolik vyrazu typu
	
	EMS_WINDOW
	&
	ACTIVE_MHFA
	&
	CHIPA_C
	
	ktere se opakuji prakticky vsude. To je presne pripad, kdy se vyplati vytvorit pomocne uzly:
	
	NODE A_CPU_ACTIVE;
	NODE B_CPU_ACTIVE;
	
	A_CPU_ACTIVE =
	      EMS_WINDOW
	   &  ACTIVE_MHFA
	   &  CHIPA_C;
	
	B_CPU_ACTIVE =
	      EMS_WINDOW
	   &  ACTIVE_MHFB
	   &  CHIPB_C;
	
	Pak se vetsina rovnic zkrati na:
	
	A_S_SELECT = A_CPU_ACTIVE;
	
	A_S_READ   = A_CPU_ACTIVE & E & Rw;
	
	A_S_WRITE  = A_CPU_ACTIVE & E & !Rw;
	
	A_G_ENABLE = A_CPU_ACTIVE & E;
	
	A_G_D_DIR  = A_CPU_ACTIVE & Rw;
	
	To je nejen citelnejsi, ale na ATF1504 casto vede i k mensimu poctu product termu, protoze fitter muze A_CPU_ACTIVE fyzicky sdilet mezi vice makrobunkami. Myslim, ze prave timto smerem se da dostat navrh pod limit bunek.
	
	*/
	
	
	
	
	
	
	
	
