Name     ATF2 ;
PartNo   001 ;
Date     14/06/2026 ;
Revision 01 ;
Designer ChatGPT ;
Company  None ;
Assembly None ;
Location None ;
Device   f1504isptqfp100;

/********************************************************************/
/* INPUTS                                                           */
/********************************************************************/

/* CPU */
PIN = E;
PIN = RW;
PIN = RESET;
PIN = HALT;
PIN = BA;

/* Memory Region from ATF1 */
PIN = MR0;
PIN = MR1;
PIN = MR2;
PIN = MR3;

/* Upper CPU address bits */
PIN = CA12;
PIN = CA13;
PIN = CA14;
PIN = CA15;

/* CPU data bus */
PIN = D0;
PIN = D1;
PIN = D2;
PIN = D3;
PIN = D4;
PIN = D5;
PIN = D6;
PIN = D7;

/* MHF A */
PIN = A_SHARE_REQUEST;
PIN = A_SHARE_DIRTY_IN;
PIN = A_HALT;
PIN = A_READ;

/* MHF B */
PIN = B_SHARE_REQUEST;
PIN = B_SHARE_DIRTY_IN;

/********************************************************************/
/* OUTPUTS                                                          */
/********************************************************************/

/* Extended RAM address */
PIN = GA12;
PIN = GA13;
PIN = GA14;
PIN = GA15;
PIN = GA16;

/* RAM control */
PIN = RAM_RD;
PIN = RAM_WR;

/* EMS RAM select */
PIN = DEV0;

/* Shared RAM A */
PIN = A_S_SELECT;
PIN = A_S_READ;
PIN = A_S_WRITE;
PIN = A_SHARED_SELECT;
PIN = A_G_ENABLE;
PIN = A_G_A_DIR;
PIN = A_G_D_DIR;
PIN = A_SHARE_GRANTED;
PIN = A_SHARE_DIRTY_OUT;

/* Shared RAM B */
PIN = B_S_SELECT;
PIN = B_S_READ;
PIN = B_S_WRITE;
PIN = B_SHARED_SELECT;
PIN = B_G_ENABLE;
PIN = B_G_A_DIR;
PIN = B_G_D_DIR;
PIN = B_SHARE_GRANTED;
PIN = B_SHARE_DIRTY_OUT;

/********************************************************************/
/* INTERNAL REGISTERS                                               */
/********************************************************************/
/*
PINNODE = [EMS1_SRC1,EMS1_SRC0,EMS1_P4,EMS1_P3,EMS1_P2,EMS1_P1,EMS1_P0];
*/
/*
REGA = [EMS1_SRC1, EMS1_SRC0, X1, EMS1_P4, EMS1_P3, EMS1_P2, EMS1_P1, EMS1_P0];
REGB = [EMS2_SRC1, EMS2_SRC0, X2, EMS2_P4, EMS2_P3, EMS2_P2, EMS2_P1, EMS2_P0];

REGC = [CHIPA_C, CHIPA_A, CHIPA_D, X3,
         CHIPB_C, CHIPB_A, CHIPB_D, X4];
*/
/********************************************************************/
/* FIELDS                                                           */
/********************************************************************/

FIELD MR = [MR3..MR0];
FIELD DATA = [D7..D0];

FIELD EMS1_PAGE = [EMS1_P4..EMS1_P0];
FIELD EMS2_PAGE = [EMS2_P4..EMS2_P0];

/********************************************************************/
/* REGION DETECT                                                    */
/********************************************************************/

EMS1_AREA = (MR:1);
EMS2_AREA = (MR:2);

REG0 = (MR:8);
REG1 = (MR:9);
REG2 = (MR:10);
REG3 = (MR:11);
REG4 = (MR:12);
REG5 = (MR:13);

RAM_AREA = (MR:0);
ROM_AREA = (MR:3);
DEV_AREA = (MR:4);

/********************************************************************/
/* REGISTER WRITES                                                  */
/********************************************************************/

REG_WRITE = E & !RW;

EMS1_WR = REG0 & REG_WRITE;
EMS2_WR = REG2 & REG_WRITE;

/********************************************************************/
/* PAGE REGISTERS                                                   */
/********************************************************************/

[EMS1_SRC1,EMS1_SRC0,X1,
 EMS1_P4,EMS1_P3,EMS1_P2,EMS1_P1,EMS1_P0].D
 = [D7,D6,D5,D4,D3,D2,D1,D0];

[EMS1_SRC1,EMS1_SRC0,X1,
 EMS1_P4,EMS1_P3,EMS1_P2,EMS1_P1,EMS1_P0].CE
 = EMS1_WR;

[EMS1_SRC1,EMS1_SRC0,X1,
 EMS1_P4,EMS1_P3,EMS1_P2,EMS1_P1,EMS1_P0].CK
 = E;

[EMS1_SRC1,EMS1_SRC0,X1,
 EMS1_P4,EMS1_P3,EMS1_P2,EMS1_P1,EMS1_P0].AR
 = RESET;


[EMS2_SRC1,EMS2_SRC0,X2,
 EMS2_P4,EMS2_P3,EMS2_P2,EMS2_P1,EMS2_P0].D
 = [D7,D6,D5,D4,D3,D2,D1,D0];

[EMS2_SRC1,EMS2_SRC0,X2,
 EMS2_P4,EMS2_P3,EMS2_P2,EMS2_P1,EMS2_P0].CE
 = EMS2_WR;

[EMS2_SRC1,EMS2_SRC0,X2,
 EMS2_P4,EMS2_P3,EMS2_P2,EMS2_P1,EMS2_P0].CK
 = E;

[EMS2_SRC1,EMS2_SRC0,X2,
 EMS2_P4,EMS2_P3,EMS2_P2,EMS2_P1,EMS2_P0].AR
 = RESET;

/********************************************************************/
/* CPU WANTS CHIP ?                                                 */
/********************************************************************/

CPU_WANTS_A =
 (!EMS1_SRC1 & EMS1_SRC0) #
 (!EMS2_SRC1 & EMS2_SRC0);

CPU_WANTS_B =
 ( EMS1_SRC1 & !EMS1_SRC0) #
 ( EMS2_SRC1 & !EMS2_SRC0);

/********************************************************************/
/* OWNERSHIP                                                        */
/********************************************************************/

CHIPA_C.D =
 CPU_WANTS_A &
 !CHIPA_A;

CHIPA_C.CK = E;
CHIPA_C.AR = RESET;

CHIPA_A.D =
 A_SHARE_REQUEST &
 !CHIPA_C;

CHIPA_A.CK = E;
CHIPA_A.AR = RESET;


CHIPB_C.D =
 CPU_WANTS_B &
 !CHIPB_A;

CHIPB_C.CK = E;
CHIPB_C.AR = RESET;

CHIPB_A.D =
 B_SHARE_REQUEST &
 !CHIPB_C;

CHIPB_A.CK = E;
CHIPB_A.AR = RESET;

/********************************************************************/
/* DIRTY FLAGS                                                      */
/********************************************************************/

CHIPA_D.D =
 (CHIPA_D & !CHIPA_C & !CHIPA_A)
 #
 CHIPA_A;

CHIPA_D.CK = E;
CHIPA_D.AR = RESET;


CHIPB_D.D =
 (CHIPB_D & !CHIPB_C & !CHIPB_A)
 #
 CHIPB_A;

CHIPB_D.CK = E;
CHIPB_D.AR = RESET;

/********************************************************************/
/* EMS STATUS                                                       */
/********************************************************************/

EMS1_C =
 (!EMS1_SRC1 & !EMS1_SRC0)
 #
 (!EMS1_SRC1 & EMS1_SRC0 & CHIPA_C)
 #
 ( EMS1_SRC1 & !EMS1_SRC0 & CHIPB_C);

EMS2_C =
 (!EMS2_SRC1 & !EMS2_SRC0)
 #
 (!EMS2_SRC1 & EMS2_SRC0 & CHIPA_C)
 #
 ( EMS2_SRC1 & !EMS2_SRC0 & CHIPB_C);

EMS1_W =
 (!EMS1_SRC1 & EMS1_SRC0 & A_SHARE_REQUEST)
 #
 ( EMS1_SRC1 & !EMS1_SRC0 & B_SHARE_REQUEST);

EMS2_W =
 (!EMS2_SRC1 & EMS2_SRC0 & A_SHARE_REQUEST)
 #
 ( EMS2_SRC1 & !EMS2_SRC0 & B_SHARE_REQUEST);

/********************************************************************/
/* REGISTER READBACK                                                */
/********************************************************************/


D0 =
   (REG0 & EMS1_P0)
 # (REG2 & EMS2_P0);

D1 =
   (REG0 & EMS1_P1)
 # (REG2 & EMS2_P1);

D2 =
   (REG0 & EMS1_P2)
 # (REG2 & EMS2_P2);

D3 =
   (REG0 & EMS1_P3)
 # (REG2 & EMS2_P3)
 # (REG4 & CHIPA_C)
 # (REG5 & CHIPB_C);

D4 =
   (REG0 & EMS1_P4)
 # (REG2 & EMS2_P4)
 # (REG4 & CHIPA_A)
 # (REG5 & CHIPB_A);

D5 =
   (REG0 & EMS1_SRC0)
 # (REG1 & EMS1_W)
 # (REG2 & EMS2_SRC0)
 # (REG3 & EMS2_W)
 # (REG4 & A_SHARE_REQUEST)
 # (REG5 & B_SHARE_REQUEST);

D6 =
   (REG0 & EMS1_SRC1)
 # (REG2 & EMS2_SRC1);

D7 =
   (REG4 & CHIPA_D)
 # (REG5 & CHIPB_D);

[D0..7].OE = REG_ACCESS & E & Rw;

/*
DATA =
 (REG0 & [EMS1_SRC1,EMS1_SRC0,0,
          EMS1_P4,EMS1_P3,EMS1_P2,EMS1_P1,EMS1_P0])

 #
 (REG1 & [0,0,0,0,0,EMS1_W,0,EMS1_C])

 #
 (REG2 & [EMS2_SRC1,EMS2_SRC0,0,
          EMS2_P4,EMS2_P3,EMS2_P2,EMS2_P1,EMS2_P0])

 #
 (REG3 & [0,0,0,0,0,EMS2_W,0,EMS2_C])

 #
 (REG4 & [0,0,0,CHIPA_D,
          A_SHARE_REQUEST,
          CHIPA_A,
          0,
          CHIPA_C])

 #
 (REG5 & [0,0,0,CHIPB_D,
          B_SHARE_REQUEST,
          CHIPB_A,
          0,
          CHIPB_C]);
DATA.OE =
 E & RW &
 (REG0 # REG1 # REG2 # REG3 # REG4 # REG5);
*/


/********************************************************************/
/* EMS PAGE ADDRESS GENERATION                                      */
/********************************************************************/

GA16 =
 (EMS1_AREA & EMS1_P4)
 #
 (EMS2_AREA & EMS2_P4);

GA15 =
 (EMS1_AREA & EMS1_P3)
 #
 (EMS2_AREA & EMS2_P3);

GA14 =
 (EMS1_AREA & EMS1_P2)
 #
 (EMS2_AREA & EMS2_P2);

GA13 =
 (EMS1_AREA & EMS1_P1)
 #
 (EMS2_AREA & EMS2_P1);

GA12 =
 (EMS1_AREA & EMS1_P0)
 #
 (EMS2_AREA & EMS2_P0);

/********************************************************************/
/* DEV0                                                             */
/********************************************************************/

DEV0 =
 (EMS1_AREA &
  !EMS1_SRC1 &
  !EMS1_SRC0)

 #
 (EMS2_AREA &
  !EMS2_SRC1 &
  !EMS2_SRC0);

/********************************************************************/
/* RAM CONTROL                                                      */
/********************************************************************/

RAM_RD =
 !(E & RW);

RAM_WR =
 !(
   E &
   !RW &
   !ROM_AREA
  );

/********************************************************************/
/* SHARED RAM A                                                     */
/********************************************************************/

EMS1_IS_A =
 EMS1_AREA &
 !EMS1_SRC1 &
 EMS1_SRC0 &
 CHIPA_C;

EMS2_IS_A =
 EMS2_AREA &
 !EMS2_SRC1 &
 EMS2_SRC0 &
 CHIPA_C;

A_ACTIVE =
 EMS1_IS_A #
 EMS2_IS_A;

A_S_SELECT =
 !A_ACTIVE;

A_S_READ =
 !(A_ACTIVE & E & RW);

A_S_WRITE =
 !(A_ACTIVE & E & !RW);

A_G_ENABLE =
 !(A_ACTIVE & E);

A_G_A_DIR = E & !E ; /* FIXME 
* Problem je, ze A_G_A_DIR neni konstanta, je to smer, kterym se predava adresa,
* cili pri bootu, kdyz je HALT a adresovou sbernici ovlada MHF je to opacne, 
* nez pri normalnim chodu v EMS okne, kde naopak CPU adresuje neco na tom MHF.
* Ale to asi opravime az v dalsim pruchodu, kdy bude fungovat preklad.
*/
 

A_G_D_DIR =
 RW;

A_SHARE_GRANTED =
 CHIPA_A;

A_SHARE_DIRTY_OUT = 
 !(
    ( CHIPA_A & CPU_WANTS_A )
  # ( !CHIPA_A & CHIPA_D )
  );

/********************************************************************/
/* SHARED RAM B                                                     */
/********************************************************************/

EMS1_IS_B =
 EMS1_AREA &
 EMS1_SRC1 &
 !EMS1_SRC0 &
 CHIPB_C;

EMS2_IS_B =
 EMS2_AREA &
 EMS2_SRC1 &
 !EMS2_SRC0 &
 CHIPB_C;

B_ACTIVE =
 EMS1_IS_B #
 EMS2_IS_B;

B_S_SELECT =
 !B_ACTIVE;

B_S_READ =
 !(B_ACTIVE & E & RW);

B_S_WRITE =
 !(B_ACTIVE & E & !RW);

B_G_ENABLE =
 !(B_ACTIVE & E);

B_G_A_DIR =E & !E ; /* FIXME 
* Problem je, ze A_G_A_DIR neni konstanta, je to smer, kterym se predava adresa,
* cili pri bootu, kdyz je HALT a adresovou sbernici ovlada MHF je to opacne, 
* nez pri normalnim chodu v EMS okne, kde naopak CPU adresuje neco na tom MHF.
* Ale to asi opravime az v dalsim pruchodu, kdy bude fungovat preklad.
*/
 


B_G_D_DIR =
 RW;

B_SHARE_GRANTED =
 CHIPB_A;

B_SHARE_DIRTY_OUT = 
 !(
    ( CHIPB_A & CPU_WANTS_B )
  # ( !CHIPB_A & CHIPB_D )
  );

/********************************************************************/
/* HALT MODE                                                        */
/********************************************************************/

A_SHARED_SELECT = E & !E ; /* FIXME tohle NENI konstanta */

B_SHARED_SELECT = E & !E ; /* FIXME tohle NENI konstanta */

/********************************************************************/
/********************************************************************/
/* HALT MODE - SYSTEM RAM ACCESS FROM MHF_A                         */
/********************************************************************/

/*
 * Puvodni zamer:
 *
 * HALT=1  => CPU bezi normalne
 * HALT=0  => CPU zastaveno, BA=1
 *
 * Pouze MHF_A smi ovladat systemovou RAM.
 */

HALT_MODE =
 !A_HALT &
 BA;

/********************************************************************/
/* RAM ADDRESS SOURCE                                               */
/********************************************************************/

/*
 * Normalne:
 *   GAxx = EMS mapovani
 *
 * HALT:
 *   GA16 = A_S16
 *   GA12..15 = CPU sbernice
 *   (ATF2 je nepotrebuje generovat)
 */

/* FIXME GA16 uz ma prirazeny vyraz driv, nutno zkombinovat
GA16 =
 (HALT_MODE & A_S16)
 #
 (!HALT_MODE &
 (
   (EMS1_AREA & EMS1_P4)
   #
   (EMS2_AREA & EMS2_P4)
 ));
*/
/********************************************************************/
/* RAM CONTROL OVERRIDE                                             */
/********************************************************************/

/*
 * CPU rezim
 */

/* FIXME CPU_RAM_RD uz ma prirazeny vyraz driv, nutno zkombinovat
CPU_RAM_RD =
 E & RW;

CPU_RAM_WR =
 E & !RW & !ROM_AREA;
*/

/*
 * HALT rezim
 *
 * A_READ = 1  -> cteni
 * A_READ = 0  -> zapis
 */

HALT_RAM_RD =
 E & A_READ;

HALT_RAM_WR =
 E & !A_READ;

/* FIXME CPU_RAM_RD uz ma prirazeny vyraz driv, nutno zkombinovat
RAM_RD =
 !(
    (HALT_MODE & HALT_RAM_RD)
    #
    (!HALT_MODE & CPU_RAM_RD)
  );

RAM_WR =
 !(
    (HALT_MODE & HALT_RAM_WR)
    #
    (!HALT_MODE & CPU_RAM_WR)
  );
*/
/********************************************************************/
/* GATE CONTROL                                                     */
/********************************************************************/

/*
 * HALT:
 *   MHF_A ridi CPU sbernici
 */

HALT_GATE_ENABLE =
 HALT_MODE;

HALT_GATE_A_DIR = E # !E; /* FIXME not konst */
 

HALT_GATE_D_DIR =
 !A_READ;

/********************************************************************/
/* EMS ACCESS                                                       */
/********************************************************************/

EMS_GATE_ENABLE =
 (A_ACTIVE # B_ACTIVE) & E;

/********************************************************************/
/* A SIDE OUTPUTS                                                   */
/********************************************************************/

/* FIXME CPU_RAM_RD uz ma prirazeny vyraz driv, nutno zkombinovat
A_G_ENABLE =
 !(
    HALT_GATE_ENABLE
    #
    EMS_GATE_ENABLE
  );

A_G_A_DIR =
 HALT_MODE
 #
 (!HALT_MODE & 0);

A_G_D_DIR =
 (HALT_MODE & !A_READ)
 #
 (!HALT_MODE & RW);
*/
/********************************************************************/
/* B SIDE OUTPUTS                                                   */
/********************************************************************/

/*
 * B nikdy HALT neridi
 */
/* FIXME CPU_RAM_RD uz ma prirazeny vyraz driv, nutno zkombinovat
B_G_ENABLE =
 !(B_ACTIVE & E);

B_G_A_DIR =
 0;

B_G_D_DIR =
 RW;
*/

/********************************************************************/
/* DEV0 DRIVER                                                      */
/********************************************************************/

/*
 * Mimo EMS:
 *   HiZ
 *
 * EMS+SystemRAM:
 *   aktivni
 */
/* FIXME CPU_RAM_RD uz ma prirazeny vyraz driv, nutno zkombinovat
DEV0 =
 (EMS1_AREA &
  !EMS1_SRC1 &
  !EMS1_SRC0)

 #
 (EMS2_AREA &
  !EMS2_SRC1 &
  !EMS2_SRC0);
*/
DEV0.OE =
 EMS1_AREA #
 EMS2_AREA;

/********************************************************************/
/* SHARE REQUEST LATCHES                                            */
/********************************************************************/

/*
 * Pokud by fitter zacal protestovat
 * proti primemu pouziti SHARE_REQUEST
 * ve vice rovnicich,
 * vyplati se udelat:
 */
/*
REGD =
[
 A_WANT,
 B_WANT,
 X5,
 X6,
 X7,
 X8,
 X9,
 X10
];

A_WANT.D  = A_SHARE_REQUEST;
A_WANT.CK = E;
A_WANT.AR = RESET;

B_WANT.D  = B_SHARE_REQUEST;
B_WANT.CK = E;
B_WANT.AR = RESET;
*/
/*
 * A pak vsude pouzivat
 *
 *   A_WANT
 *   B_WANT
 *
 * misto primych vstupu.
 *
 * Casto to snizi pocet product terms.
 */

/********************************************************************/
/* VLASTNICTVI - USPORNEJSI VERZE                                   */
/********************************************************************/

/*
 * Pokud zacne dochazet logika,
 * da se zahodit samostatne C a A
 * a drzet jen jednoho vlastnika:
 *
 * OWNERA = CPU vlastni A
 * OWNERB = CPU vlastni B
 *
 * a MHF vlastnictvi se dopocita.
 *
 * Ale zatim bych to nedelal.
 *
 * Nejprve zkusit prelozit soucasnou verzi
 * a podivat se na:
 *
 *   Logic Cells
 *   Product Terms
 *   Foldback
 *
 * Teprve pak optimalizovat.
 */

/********************************************************************/
/* RESET DEFAULT PAGE REGISTERS                                     */
/********************************************************************/

/*
 * Volitelne:
 *
 * EMS1 -> 08000
 * EMS2 -> 09000
 *
 * Pokud bude potreba.
 *
 * WinCUPL neumi jednoduse inicializovat
 * registry na jinou hodnotu nez 0,
 * takze by se muselo resit
 * specialnim reset stavem.
 *
 * Ja bych to zatim nechal na BIOSu.
 */

/********************************************************************/
/* END OF FILE                                                      */
/********************************************************************/
